<ContentDialog
	x:Class="AutoOS.App.Dialogs.Network.OptimizeAdapterDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:device="using:AutoOS.Core.Data.Models.Device"
	xmlns:local="using:AutoOS.App.Dialogs.Network"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
	Title="{x:Bind ViewModel.Title, Mode=OneWay}"
	CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
	DefaultButton="Close"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryButtonEnabled, Mode=OneWay}"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="ContentDialog" />
		<wctconverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</ContentDialog.Resources>

	<ListView
		x:Name="Adapters"
		ItemsSource="{x:Bind ViewModel.Adapters}"
		Loaded="Adapters_Loaded"
		SelectionChanged="Adapters_SelectionChanged"
		SelectionMode="Multiple">
		<ListView.ItemTemplate>
			<DataTemplate x:DataType="device:DeviceInfo">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  WiFi Icon  -->
					<FontIcon
						Grid.RowSpan="2"
						Width="32"
						Height="32"
						Margin="6"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="24"
						Foreground="{ThemeResource SystemAccentColor}"
						Glyph="&#xE701;"
						Visibility="{x:Bind IsWiFi, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

					<!--  Ethernet Icon  -->
					<FontIcon
						Grid.RowSpan="2"
						Width="32"
						Height="32"
						Margin="6"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						FontSize="24"
						Foreground="{ThemeResource SystemAccentColor}"
						Glyph="&#xE839;"
						Visibility="{x:Bind IsLAN, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

					<!--  Name  -->
					<TextBlock
						Grid.Column="1"
						Margin="12,6,0,0"
						FontWeight="Normal"
						Text="{x:Bind FriendlyName, Mode=OneWay}" />

					<!--  Version  -->
					<TextBlock
						Grid.Row="1"
						Grid.Column="1"
						Margin="12,0,0,6"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"><Run Text="{x:Bind DriverType, Mode=OneWay}" /><Run Text=" " /><Run Text="{x:Bind CurrentVersion, Mode=OneWay}" /></TextBlock>
				</Grid>
			</DataTemplate>
		</ListView.ItemTemplate>
	</ListView>
</ContentDialog>
