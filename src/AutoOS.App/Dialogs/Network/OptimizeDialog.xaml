<ContentDialog
	x:Class="AutoOS.App.Dialogs.Network.OptimizeDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:device="using:AutoOS.Core.Data.Models.Device"
	xmlns:local="using:AutoOS.App.Dialogs.Network"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{x:Bind ViewModel.Title, Mode=OneWay}"
	CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
	DefaultButton="Close"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryButtonEnabled, Mode=OneWay}"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:OptimizeDialog" />
	</ContentDialog.Resources>

	<Grid RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Description  -->
		<TextBlock
			Grid.Row="0"
			Text="Select the network adapters to optimize:"
			TextWrapping="Wrap" />

		<!--  Adapters  -->
		<ListView
			x:Name="Adapters"
			Grid.Row="1"
			ItemsSource="{x:Bind ViewModel.Adapters}"
			SelectionChanged="Adapters_SelectionChanged"
			SelectionMode="Multiple">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="device:DeviceInfo">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  Icon  -->
						<FontIcon
							Grid.RowSpan="2"
							FontSize="24"
							Foreground="{ThemeResource SystemAccentColor}"
							Glyph="{x:Bind Glyph, Mode=OneWay}" />

						<!--  Name  -->
						<TextBlock
							Grid.Column="1"
							Margin="8,4,0,0"
							FontWeight="Normal"
							Text="{x:Bind FriendlyName, Mode=OneWay}" />

						<!--  Description  -->
						<TextBlock
							Grid.Row="1"
							Grid.Column="1"
							Margin="8,0,0,4"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Style="{StaticResource CaptionTextBlockStyle}">
							<Run Text="{x:Bind DriverType, Mode=OneWay}" />
							<Run Text=" " />
							<Run Text="{x:Bind CurrentVersion, Mode=OneWay}" />
						</TextBlock>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</ContentDialog>
