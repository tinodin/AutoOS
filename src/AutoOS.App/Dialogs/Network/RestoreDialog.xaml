<ContentDialog
	x:Class="AutoOS.App.Dialogs.Network.RestoreDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:device="using:AutoOS.Core.Data.Models.Device"
	xmlns:local="using:AutoOS.App.Dialogs.Network"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{x:Bind ViewModel.Title, Mode=OneWay}"
	CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
	DefaultButton="Close"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryButtonEnabled, Mode=OneWay}"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:RestoreDialog" />
	</ContentDialog.Resources>

	<Grid RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Description  -->
		<TextBlock
			Grid.Row="0"
			Text="Select the network adapters to restore:"
			TextWrapping="Wrap" />

		<!--  Adapters  -->
		<ListView
			x:Name="Adapters"
			Grid.Row="1"
			ItemsSource="{x:Bind ViewModel.Adapters}"
			SelectionChanged="Adapters_SelectionChanged"
			SelectionMode="Multiple">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="device:DeviceInfo">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<!--  Icon  -->
						<FontIcon Foreground="{ThemeResource SystemColorControlAccentColor}" Glyph="{x:Bind Glyph, Mode=OneWay}" />

						<!--  Name  -->
						<TextBlock Text="{x:Bind FriendlyName, Mode=OneWay}" />
					</StackPanel>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</ContentDialog>
