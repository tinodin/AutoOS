<ContentDialog
	x:Class="AutoOS.App.Dialogs.Power.CompareDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:AutoOS.App.Dialogs.Power"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:AutoOS.Core.Data.Models.Power"
	Title="{x:Bind ViewModel.Title, Mode=OneWay}"
	CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
	DefaultButton="Close"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryButtonEnabled, Mode=OneWay}"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:CompareDialog" />
		<DataTemplate x:Key="ComparePlanItemTemplate" x:DataType="models:Plan">
			<TextBlock Text="{x:Bind Name, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind Description, Mode=OneTime}" />
		</DataTemplate>
	</ContentDialog.Resources>

	<StackPanel Spacing="12">

		<!--  Description  -->
		<TextBlock Text="Select two power plans to compare." TextWrapping="Wrap" />

		<!--  Power Plan 1  -->
		<ComboBox
			x:Name="Plan1ComboBox"
			HorizontalAlignment="Stretch"
			Header="Power plan 1:"
			ItemTemplate="{StaticResource ComparePlanItemTemplate}"
			ItemsSource="{x:Bind ViewModel.Plans, Mode=OneTime}"
			SelectedItem="{x:Bind ViewModel.SelectedPlan1, Mode=TwoWay}" />

		<!--  Power Plan 2  -->
		<ComboBox
			x:Name="Plan2ComboBox"
			HorizontalAlignment="Stretch"
			Header="Power plan 2:"
			ItemTemplate="{StaticResource ComparePlanItemTemplate}"
			ItemsSource="{x:Bind ViewModel.Plans, Mode=OneTime}"
			SelectedItem="{x:Bind ViewModel.SelectedPlan2, Mode=TwoWay}" />
	</StackPanel>
</ContentDialog>
