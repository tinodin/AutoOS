<ContentDialog
	x:Class="AutoOS.App.Dialogs.Power.EditDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:AutoOS.App.Dialogs.Power"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{x:Bind ViewModel.Title, Mode=OneWay}"
	CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
	DefaultButton="Close"
	IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryButtonEnabled, Mode=OneWay}"
	PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="local:EditDialog" />
	</ContentDialog.Resources>

	<!--  Name  -->
	<StackPanel Spacing="12">
		<TextBox
			x:Name="NameTextBox"
			Header="Name:"
			Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


		<!--  Description  -->
		<TextBox
			x:Name="DescriptionTextBox"
			MaxHeight="500"
			AcceptsReturn="True"
			Header="Description:"
			Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			TextWrapping="Wrap" />
	</StackPanel>
</ContentDialog>
