<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="AutoOS.App.UserControls.MediaFullscreenViewer"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Visibility="Collapsed"
	mc:Ignorable="d">
	<UserControl.Resources>
		<Style x:Key="MediaOverlayButtonStyle"
			TargetType="Button">
			<Setter Property="Background" Value="#E6FFFFFF" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<ContentPresenter
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							ContentTransitions="{TemplateBinding ContentTransitions}"
							CornerRadius="{TemplateBinding CornerRadius}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
							Padding="{TemplateBinding Padding}"
							VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="MediaNavigationButtonStyle"
			TargetType="Button"
			BasedOn="{StaticResource MediaOverlayButtonStyle}">
			<Setter Property="Background" Value="#E6FFFFFF" />
			<Setter Property="CornerRadius" Value="16" />
		</Style>
		<Style x:Key="MediaCloseButtonStyle"
			TargetType="Button"
			BasedOn="{StaticResource MediaOverlayButtonStyle}">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
	</UserControl.Resources>
	<Grid
		x:Name="RootGrid"
		Background="Transparent"
		IsTabStop="True"
		KeyDown="Root_KeyDown">
		<Border x:Name="Backdrop" Background="#E60B0E14" />

			<!--  Media container with generous margins and rounded corners  -->
		<Border
			x:Name="MediaHost"
			Margin="140,80,140,78"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			CornerRadius="8"
			Opacity="1">
			<Border.RenderTransform>
				<CompositeTransform ScaleX="1" ScaleY="1" />
			</Border.RenderTransform>
			<Grid>
				<Image
					x:Name="PosterImage"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					AutomationProperties.AccessibilityView="Raw"
					Stretch="Uniform" />
				<MediaPlayerElement
					x:Name="Player"
					AreTransportControlsEnabled="True"
					AutoPlay="False"
					Visibility="Collapsed" />
			</Grid>
		</Border>

		<Grid x:Name="OverlayChrome">
			<!--  Label + counter pill at bottom center  -->
			<StackPanel
			Margin="140,0,140,24"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Spacing="8">
			<TextBlock
				x:Name="MediaLabelText"
				HorizontalAlignment="Center"
				FontFamily="Segoe UI Variable Text"
				FontSize="16"
				Foreground="#EEFFFFFF"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<Border
				Padding="14,4"
				HorizontalAlignment="Center"
				Background="#50000000"
				BorderBrush="#25FFFFFF"
				BorderThickness="1"
				CornerRadius="12">
				<TextBlock
					x:Name="CounterText"
					FontFamily="Segoe UI Variable"
					FontSize="12"
					FontWeight="Medium"
					Foreground="#CCFFFFFF" />
			</Border>
			</StackPanel>

			<!--  Buttons overlay  -->
			<Grid>
		<!-- Close button top-right -->
		<Button x:Name="CloseButton"
			Width="34"
			Height="34"
			Margin="0,24,24,0"
			Padding="0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			AutomationProperties.Name="Close"
			Click="CloseButton_Click"
			Foreground="#FFE0E0E0"
			PointerEntered="CloseButton_PointerEntered"
			PointerExited="CloseButton_PointerExited"
			Style="{StaticResource MediaCloseButtonStyle}">
			<FontIcon FontSize="12" Foreground="#FFE0E0E0" Glyph="&#xE8BB;" />
		</Button>

		<!-- Store-style FlipView navigation buttons. -->
		<Grid Margin="0,32,0,0" VerticalAlignment="Center">
			<Button x:Name="ScrollBackBtn"
				Width="32"
				Height="32"
				Margin="40,0,0,0"
				AutomationProperties.Name="Scroll left"
				Click="ScrollBackBtn_Click"
				FontFamily="{ThemeResource ContentControlThemeFontFamily}"
				PointerEntered="NavigationButton_PointerEntered"
				PointerExited="NavigationButton_PointerExited"
				Style="{StaticResource MediaNavigationButtonStyle}"
				Visibility="Collapsed">
				<FontIcon FontSize="{ThemeResource FlipViewButtonFontSize}"
					Foreground="#FF8A8A8A"
					Glyph="&#xedd9;" />
			</Button>
			<Button x:Name="ScrollForwardBtn"
				Width="32"
				Height="32"
				Margin="0,0,40,0"
				HorizontalAlignment="Right"
				AutomationProperties.Name="Scroll right"
				Click="ScrollForwardBtn_Click"
				FontFamily="{ThemeResource ContentControlThemeFontFamily}"
				PointerEntered="NavigationButton_PointerEntered"
				PointerExited="NavigationButton_PointerExited"
				Style="{StaticResource MediaNavigationButtonStyle}">
				<FontIcon FontSize="{ThemeResource FlipViewButtonFontSize}"
					Foreground="#FF8A8A8A"
					Glyph="&#xEDDA;" />
			</Button>
		</Grid>
			</Grid>
		</Grid>
</Grid>
</UserControl>
