<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid">

	<!--  Critical  -->
	<Style x:Key="CriticalCellStyle" TargetType="sfgrid:TreeGridCell">
		<Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
	</Style>

	<!--  Success  -->
	<Style x:Key="SuccessCellStyle" TargetType="sfgrid:TreeGridCell">
		<Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />

	</Style>

</ResourceDictionary>
