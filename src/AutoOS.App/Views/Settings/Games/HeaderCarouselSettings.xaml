<ContentDialog x:Class="AutoOS.Views.Settings.Games.HeaderCarouselSettings"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:CommunityToolkit.WinUI.Controls"
               xmlns:dev="using:DevWinUI"
               xmlns:views="using:AutoOS.Views.Settings">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMinWidth">960</x:Double>
            <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
            <x:Double x:Key="ContentDialogMinHeight">740</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">740</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="10"
                        Spacing="2">
                <TextBlock Text="Settings"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,10" />
                
                <dev:SimpleSettingsGroup Header="Epic Games">
                    <dev:SettingsCard Header="Epic Games Account"
                                      Description="Manage your Epic Accounts">
                        <dev:SettingsCard.HeaderIcon>
                            <ImageIcon Source="/Assets/Fluent/Epicgames.png" />
                        </dev:SettingsCard.HeaderIcon>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox x:Name="EpicGamesAccounts"
                                      Grid.Column="0" />
                            
                            <Button x:Name="AddEpicGamesAccount"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="AddEpicGamesAccount_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <FontIcon Margin="0,0,8,0"
                                              FontSize="16"
                                              Foreground="CornflowerBlue"
                                              Glyph="&#xE710;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Add" />
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="RemoveEpicGamesAccount"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Click="RemoveEpicGamesAccount_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <FontIcon Margin="0,0,8,0"
                                              FontSize="16"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                              Glyph="&#xE74D;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Remove" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </dev:SettingsCard>
                </dev:SimpleSettingsGroup>
                
                <dev:SimpleSettingsGroup Header="Steam">
                    <dev:SettingsCard Header="Steam Account"
                                      Description="Manage your Steam Accounts">
                        <dev:SettingsCard.HeaderIcon>
                            <ImageIcon Source="/Assets/Fluent/Steam.png" />
                        </dev:SettingsCard.HeaderIcon>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox x:Name="SteamAccounts"
                                      Grid.Column="0" />
                            
                            <Button x:Name="AddSteamAccount"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="AddSteamAccount_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <FontIcon Margin="0,0,8,0"
                                              FontSize="16"
                                              Foreground="CornflowerBlue"
                                              Glyph="&#xE710;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Add" />
                                </StackPanel>
                            </Button>
                            
                            <Button x:Name="RemoveSteamAccount"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Click="RemoveSteamAccount_Click">
                                <StackPanel HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                    <FontIcon Margin="0,0,8,0"
                                              FontSize="16"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                              Glyph="&#xE74D;" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Remove" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </dev:SettingsCard>
                </dev:SimpleSettingsGroup>
                
                <dev:SimpleSettingsGroup Header="Emulators">
                    <dev:SettingsExpander x:Name="EmulatorsSettingsExpander"
                                          Description=""
                                          Header="Switch Emulators">
                        <dev:SettingsExpander.HeaderIcon>
                            <ImageIcon x:Name="SelectedEmulatorIcon"
                                       Source="/Assets/Fluent/Eden.png" />
                        </dev:SettingsExpander.HeaderIcon>
                        <dev:SettingsExpander.Content>
                            <ComboBox x:Name="EmulatorComboBox"
                                      SelectionChanged="EmulatorComboBox_SelectionChanged">
                                <ComboBoxItem Tag="Eden">Eden</ComboBoxItem>
                                <ComboBoxItem Tag="Citron">Citron</ComboBoxItem>
                                <ComboBoxItem Tag="Ryujinx">Ryujinx</ComboBoxItem>
                            </ComboBox>
                        </dev:SettingsExpander.Content>
                        <dev:SettingsExpander.Items>
                            <dev:SettingsCard Header="Executable Location">
                                <dev:TextBox x:Name="ExecutableLocationValue"
                                             MinWidth="300"
                                             PlaceholderText="Executable Location..."
                                             TextChanged="ExecutableLocation_TextChanged">
                                    <dev:TextBox.Content>
                                        <Button Click="ExecutableLocation_Click"
                                                Content="&#xE838;" />
                                    </dev:TextBox.Content>
                                </dev:TextBox>
                            </dev:SettingsCard>
                            <dev:SettingsCard Header="Data Location">
                                <dev:TextBox x:Name="DataLocationValue"
                                             MinWidth="300"
                                             PlaceholderText="Data Location..."
                                             TextChanged="DataLocation_TextChanged">
                                    <dev:TextBox.Content>
                                        <Button Click="DataLocation_Click"
                                                Content="&#xE838;" />
                                    </dev:TextBox.Content>
                                </dev:TextBox>
                            </dev:SettingsCard>
                        </dev:SettingsExpander.Items>
                    </dev:SettingsExpander>
                </dev:SimpleSettingsGroup>
                
                <dev:SimpleSettingsGroup Header="Format">
                    <dev:SettingsCard Header="Playtime Format">
                        <dev:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE916;" />
                        </dev:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="PlaytimeFormatComboBox"
                                  SelectionChanged="PlaytimeFormatComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Compact">Default</ComboBoxItem>
                            <ComboBoxItem Tag="Detailed">Steam</ComboBoxItem>
                        </ComboBox>
                    </dev:SettingsCard>
                </dev:SimpleSettingsGroup>
            </StackPanel>
        </ScrollViewer>

        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Width="32"
                Height="32"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Click="Close_Click">
            <FontIcon FontSize="16"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE711;" />
        </Button>
    </Grid>
</ContentDialog>