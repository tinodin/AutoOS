<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AutoOS.Views.Settings.BenchmarksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
      xmlns:common="using:AutoOS.Common"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:AutoOS.Views.Settings.Benchmarks"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:sfdata="using:Syncfusion.UI.Xaml.DataGrid"
      xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid"
      mc:Ignorable="d">
    <Page.Resources>
        <!--  Critical  -->
        <Style x:Key="CriticalCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>

        <!--  Success  -->
        <Style x:Key="SuccessCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>

        <!--  Cell style selector  -->
        <local:ResultCellStyleSelector x:Key="RecordingACellStyleSelector"
                                       CriticalStyle="{StaticResource CriticalCellStyle}"
                                       IsRecordingA="True"
                                       SuccessStyle="{StaticResource SuccessCellStyle}" />
        <local:ResultCellStyleSelector x:Key="RecordingBCellStyleSelector"
                                       CriticalStyle="{StaticResource CriticalCellStyle}"
                                       SuccessStyle="{StaticResource SuccessCellStyle}" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Margin="36,24,36,0">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                       Text="Benchmarks" />

            <!--  Command Bar  -->
            <controls:TabbedCommandBar x:Name="BenchmarksSelectorBar"
                                       Margin="0,48,0,0"
                                       common:CommandBarExtensions.ApplyOverflowIndent="True"
                                       common:CommandBarExtensions.CommandAlignment="Left"
                                       common:CommandBarExtensions.OverflowButtonAlignment="Right"
                                       SelectedItem="{x:Bind RecordingsTab}"
                                       SelectionChanged="BenchmarksSelectorBar_SelectionChanged">
                <controls:TabbedCommandBar.MenuItems>

                    <!--  Recordings  -->
                    <controls:TabbedCommandBarItem x:Name="RecordingsTab"
                                                   Header="Recordings">
                        <controls:TabbedCommandBarItem.PrimaryCommands>

                            <!--  Add  -->
                            <AppBarButton Click="AddRecording_Click"
                                          Label="Add">
                                <AppBarButton.Content>
                                    <dev:ThemedIcon Style="{StaticResource App.ThemedIcons.New.Item}" />
                                </AppBarButton.Content>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N"
                                                         Modifiers="Control" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Rename  -->
                            <AppBarButton Click="RenameRecording_Click"
                                          IsEnabled="{x:Bind ViewModel.IsRenameEnabled, Mode=OneWay}"
                                          Label="Rename"
                                          ToolTipService.ToolTip="Rename (F2)">
                                <AppBarButton.Content>
                                    <dev:ThemedIcon Style="{StaticResource App.ThemedIcons.Rename}" />
                                </AppBarButton.Content>
                            </AppBarButton>

                            <!--  Delete  -->
                            <AppBarButton Click="DeleteRecording_Click"
                                          IsEnabled="{x:Bind ViewModel.IsDeleteEnabled, Mode=OneWay}"
                                          Label="Delete">
                                <AppBarButton.Content>
                                    <dev:ThemedIcon Style="{StaticResource App.ThemedIcons.Delete}" />
                                </AppBarButton.Content>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Delete" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>

                            <!--  Aggregate  -->
                            <AppBarButton x:Name="Aggregate"
                                          Click="Aggregate_Click"
                                          Icon="{dev:FontIcon Glyph=&#xEA3C;}"
                                          IsEnabled="{x:Bind ViewModel.IsAggregateEnabled, Mode=OneWay}"
                                          Label="Aggregate">
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="A"
                                                         Modifiers="Menu" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Process  -->
                            <AppBarElementContainer>
                                <AutoSuggestBox x:Name="ProcessAutoSuggestBox"
                                                MinWidth="200"
                                                GotFocus="ProcessAutoSuggestBox_GotFocus"
                                                ItemsSource="{x:Bind ViewModel.ProcessSuggestions, Mode=OneWay}"
                                                PlaceholderText="Select a process..."
                                                SuggestionChosen="ProcessAutoSuggestBox_SuggestionChosen"
                                                Text="{x:Bind ViewModel.ProcessName, Mode=TwoWay}"
                                                TextChanged="ProcessAutoSuggestBox_TextChanged"
                                                ToolTipService.ToolTip="Process" />
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Duration  -->
                            <AppBarElementContainer>
                                <NumberBox LargeChange="5"
                                           Minimum="3"
                                           PlaceholderText="Duration (s)"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="Duration (s)"
                                           Value="{x:Bind ViewModel.RecordingDuration, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <!--  Delay  -->
                            <AppBarElementContainer Margin="2,0">
                                <NumberBox LargeChange="5"
                                           Maximum="60"
                                           Minimum="0"
                                           PlaceholderText="Delay (s)"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="Delay (s)"
                                           Value="{x:Bind ViewModel.RecordingDelay, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Hotkey  -->
                            <AppBarElementContainer>
                                <dev:Shortcut x:Name="HotkeyShortcut"
                                              Keys="{x:Bind ViewModel.ShortcutKeys, Mode=OneWay}"
                                              PrimaryButtonClick="HotkeyShortcut_PrimaryButtonClick"
                                              Style="{StaticResource SmallShortcutStyle}"
                                              UseAutoValidation="True" />
                            </AppBarElementContainer>

                            <!--  Record  -->
                            <AppBarToggleButton x:Name="Record"
                                                Checked="Record_Checked"
                                                Icon="{dev:FontIcon Glyph=&#xE7C8;}"
                                                IsEnabled="{x:Bind ViewModel.CanRecord, Mode=OneWay}"
                                                Label="{x:Bind ViewModel.RecordLabel, Mode=OneWay}"
                                                Unchecked="Record_Unchecked">
                            </AppBarToggleButton>

                        </controls:TabbedCommandBarItem.PrimaryCommands>
                    </controls:TabbedCommandBarItem>

                    <!--  Analysis  -->
                    <controls:TabbedCommandBarItem x:Name="AnalysisTab"
                                                   Header="Analysis">
                        <controls:TabbedCommandBarItem.PrimaryCommands>

                            <!--  Chart Type  -->
                            <AppBarElementContainer Margin="4,0,0,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Chart Type">
                                <dev:SelectorBarSegmented SelectionChanged="AnalysisChartTypeSelector_SelectionChanged">
                                    <SelectorBarItem x:Name="BarChartItem"
                                                     IsSelected="True"
                                                     Text="Bar" />
                                    <SelectorBarItem x:Name="ColumnChartItem"
                                                     Text="Column" />
                                    <SelectorBarItem x:Name="LineChartItem"
                                                     Text="Line" />
                                    <SelectorBarItem x:Name="ScatterChartItem"
                                                     Text="Scatter" />
                                </dev:SelectorBarSegmented>
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Bar / Column Metrics  -->
                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="0.1% Low Avg"
                                              IsChecked="{x:Bind ViewModel.ShowLow01, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="1% Low Avg"
                                              IsChecked="{x:Bind ViewModel.ShowLow1, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <AppBarSeparator Margin="4,0"
                                             Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}" />

                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="Avg (Arithmetic)"
                                              IsChecked="{x:Bind ViewModel.ShowAvgArithmetic, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="Avg (Harmonic)"
                                              IsChecked="{x:Bind ViewModel.ShowAvgHarmonic, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <AppBarSeparator Margin="4,0"
                                             Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}" />

                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="Min"
                                              IsChecked="{x:Bind ViewModel.ShowMin, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="Max"
                                              IsChecked="{x:Bind ViewModel.ShowMax, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <AppBarSeparator Margin="4,0"
                                             Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}" />

                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="P0.1"
                                              IsChecked="{x:Bind ViewModel.ShowP01, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="P1"
                                              IsChecked="{x:Bind ViewModel.ShowP1, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="P5"
                                              IsChecked="{x:Bind ViewModel.ShowP5, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="P50 (Median)"
                                              IsChecked="{x:Bind ViewModel.ShowP50Median, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer Margin="0,0,4,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="P95"
                                              IsChecked="{x:Bind ViewModel.ShowP95, Mode=TwoWay}" />
                            </AppBarElementContainer>
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    Visibility="{x:Bind ViewModel.BarMetricsVisibility, Mode=OneWay}">
                                <ToggleButton Content="P99"
                                              IsChecked="{x:Bind ViewModel.ShowP99, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <!--  Line / Scatter Metrics  -->
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Graph 2 Metric"
                                                    Visibility="{x:Bind ViewModel.MetricVisibility, Mode=OneWay}">
                                <ComboBox x:Name="Metric1ComboBox"
                                          MinWidth="215"
                                          SelectedIndex="0"
                                          SelectionChanged="MetricComboBox_SelectionChanged">
                                    <x:String>MsBetweenDisplayChange</x:String>
                                    <x:String>MsBetweenPresents</x:String>
                                    <x:String>MsGPUBusy</x:String>
                                    <x:String>MsUntilDisplayed</x:String>
                                </ComboBox>
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Recording A Color Picker  -->
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Recording A Color">
                                <dev:DropdownColorPicker VerticalAlignment="Bottom"
                                                         ColorSpectrumShape="Ring"
                                                         IsAlphaEnabled="True"
                                                         IsAlphaSliderVisible="True"
                                                         IsMoreButtonVisible="True"
                                                         Tag="RecordingA"
                                                         Color="{x:Bind ViewModel.ChartColor1, Mode=TwoWay}">
                                </dev:DropdownColorPicker>
                            </AppBarElementContainer>
                            <!--  Recording B Color Picker  -->
                            <AppBarElementContainer Margin="4,0,0,0"
                                                    ToolTipService.ToolTip="Recording B Color"
                                                    Visibility="{x:Bind ViewModel.HasSecondRecordingVisibility, Mode=OneWay}">
                                <dev:DropdownColorPicker VerticalAlignment="Bottom"
                                                         ColorSpectrumShape="Ring"
                                                         IsAlphaEnabled="True"
                                                         IsAlphaSliderVisible="True"
                                                         IsMoreButtonVisible="True"
                                                         Tag="RecordingB"
                                                         Color="{x:Bind ViewModel.ChartColor2, Mode=TwoWay}">
                                </dev:DropdownColorPicker>
                            </AppBarElementContainer>
                        </controls:TabbedCommandBarItem.PrimaryCommands>
                    </controls:TabbedCommandBarItem>

                    <!--  Statistics  -->
                    <controls:TabbedCommandBarItem x:Name="StatisticsTab"
                                                   Header="Statistics" />
                </controls:TabbedCommandBar.MenuItems>
            </controls:TabbedCommandBar>
        </StackPanel>

        <dev:SwitchPresenter Grid.Row="1"
                             Margin="36,8,36,36"
                             Value="{x:Bind ViewModel.ActiveTab, Mode=OneWay}">
            <!--  Recordings  -->
            <dev:Case Value="Recordings">
                <dev:SwitchPresenter Value="{x:Bind ViewModel.RecordingState, Mode=OneWay}">
                    <dev:Case Value="Content">

                        <!--  Recordings TreeGrid  -->
                        <sfgrid:SfTreeGrid x:Name="RecordingsTreeGrid"
                                           AllowEditing="True"
                                           AllowTriStateSorting="True"
                                           AutoGenerateColumns="False"
                                           CheckBoxSelectionMode="SynchronizeSelection"
                                           ChildPropertyName="Children"
                                           ColumnWidthMode="Star"
                                           CurrentCellEndEdit="RecordingsTreeGrid_CurrentCellEndEdit"
                                           EditTrigger="OnDoubleTap"
                                           GridLinesVisibility="Both"
                                           HeaderLinesVisibility="Both"
                                           ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                                           NavigationMode="Cell"
                                           PasteOption="None"
                                           SelectionChanged="RecordingsTreeGrid_SelectionChanged"
                                           SelectionMode="Multiple"
                                           ShowCheckBox="True"
                                           ShowToolTip="True"
                                           SizeChanged="RecordingsTreeGrid_SizeChanged">
                            <sfgrid:SfTreeGrid.ColumnSizer>
                                <common:TreeGridStarColumnSizer />
                            </sfgrid:SfTreeGrid.ColumnSizer>
                            <sfgrid:SfTreeGrid.Columns>

                                <!--  Title  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                                           HeaderText="Title"
                                                           MappingName="Title"
                                                           MinimumWidth="70"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Process  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                                           AllowFocus="False"
                                                           HeaderText="Process"
                                                           IsReadOnly="True"
                                                           MappingName="Process"
                                                           MinimumWidth="80"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Presentation Mode  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                                           AllowFocus="False"
                                                           HeaderText="Presentation Mode"
                                                           IsReadOnly="True"
                                                           MappingName="PresentationMode"
                                                           MinimumWidth="125"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Duration  -->
                                <sfgrid:TreeGridNumericColumn common:StarRatio.ColumnRatio="1"
                                                              AllowFocus="False"
                                                              DisplayNumberFormat="0.# s"
                                                              HeaderText="Duration"
                                                              IsReadOnly="True"
                                                              MappingName="DurationSeconds"
                                                              MaximumWidth="80"
                                                              MinimumWidth="75"
                                                              ShowToolTip="True"
                                                              TextTrimming="CharacterEllipsis"
                                                              TextWrapping="NoWrap" />

                                <!--  Date / Time  -->
                                <sfgrid:TreeGridDateColumn common:StarRatio.ColumnRatio="1"
                                                           AllowFocus="False"
                                                           DisplayDateFormat="dd/MM/yy HH:mm"
                                                           HeaderText="Date / Time"
                                                           IsReadOnly="True"
                                                           MappingName="Date"
                                                           MaximumWidth="125"
                                                           MinimumWidth="100"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                            </sfgrid:SfTreeGrid.Columns>
                        </sfgrid:SfTreeGrid>
                    </dev:Case>

                    <!--  No Recordings  -->
                    <dev:Case Value="Empty">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Glyph="&#xE9F9;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No recordings found"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>

                </dev:SwitchPresenter>
            </dev:Case>

            <!--  Analysis  -->
            <dev:Case Value="Analysis">
                <dev:SwitchPresenter Value="{x:Bind ViewModel.AnalysisState, Mode=OneWay}">
                    <dev:Case Value="Content">
                        <dev:SwitchPresenter Value="{x:Bind ViewModel.AnalysisChartType, Mode=OneWay}">
                            <dev:Case Value="Bar">

                                <!--  Bar Chart  -->
                                <chart:SfCartesianChart x:Name="FpsChart"
                                                        IsTransposed="True">
                                    <chart:SfCartesianChart.Legend>
                                        <chart:ChartLegend ToggleSeriesVisibility="True" />
                                    </chart:SfCartesianChart.Legend>

                                    <!--  X Axis (FPS)  -->
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis IsInversed="True"
                                                            ShowMajorGridLines="False" />
                                    </chart:SfCartesianChart.XAxes>

                                    <!--  Y Axis (Metrics)  -->
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis EdgeLabelsDrawingMode="Shift"
                                                             Header="{x:Bind ViewModel.BarColumnChartYAxisLabel, Mode=OneWay}"
                                                             RangePadding="AppendInterval"
                                                             ShowMajorGridLines="True" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:SfCartesianChart.Series>
                                        <chart:ColumnSeries x:Name="FpsChart1Series"
                                                            EnableAnimation="True"
                                                            Fill="{x:Bind ViewModel.ChartColorBrush1, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartDisplayedData1, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartDisplayedLabel1, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                        <chart:ColumnSeries x:Name="FpsRenderedChart1Series"
                                                            EnableAnimation="True"
                                                            IsVisibleOnLegend="{x:Bind ViewModel.BarColumnRenderedVisible, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartRenderedData1, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartRenderedLabel1, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            Visibility="{x:Bind ViewModel.BarColumnRenderedVisibility, Mode=OneWay}"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.Fill>
                                                <SolidColorBrush Color="{x:Bind ViewModel.ChartRenderedColor1, Mode=OneWay}" />
                                            </chart:ColumnSeries.Fill>
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                        <chart:ColumnSeries x:Name="FpsChart2Series"
                                                            EnableAnimation="True"
                                                            Fill="{x:Bind ViewModel.ChartColorBrush2, Mode=OneWay}"
                                                            IsVisibleOnLegend="{x:Bind ViewModel.HasSecondRecording, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartDisplayedData2, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartDisplayedLabel2, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            Visibility="{x:Bind ViewModel.HasSecondRecordingVisibility, Mode=OneWay}"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                        <chart:ColumnSeries x:Name="FpsRenderedChart2Series"
                                                            EnableAnimation="True"
                                                            IsVisibleOnLegend="{x:Bind ViewModel.HasSecondRecording, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartRenderedData2, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartRenderedLabel2, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            Visibility="{x:Bind ViewModel.HasSecondRecordingVisibility, Mode=OneWay}"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.Fill>
                                                <SolidColorBrush Color="{x:Bind ViewModel.ChartRenderedColor2, Mode=OneWay}" />
                                            </chart:ColumnSeries.Fill>
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                    </chart:SfCartesianChart.Series>
                                </chart:SfCartesianChart>
                            </dev:Case>
                            <dev:Case Value="Column">

                                <!--  Column Chart  -->
                                <chart:SfCartesianChart x:Name="ColumnFpsChart">
                                    <chart:SfCartesianChart.Legend>
                                        <chart:ChartLegend ToggleSeriesVisibility="True" />
                                    </chart:SfCartesianChart.Legend>

                                    <!--  X Axis (Metrics)  -->
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:CategoryAxis LabelPlacement="BetweenTicks"
                                                            ShowMajorGridLines="False" />
                                    </chart:SfCartesianChart.XAxes>

                                    <!--  Y Axis (FPS)  -->
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis EdgeLabelsDrawingMode="Shift"
                                                             Header="{x:Bind ViewModel.BarColumnChartYAxisLabel, Mode=OneWay}"
                                                             RangePadding="AppendInterval"
                                                             ShowMajorGridLines="True" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:SfCartesianChart.Series>
                                        <chart:ColumnSeries x:Name="ColumnFpsChart1Series"
                                                            EnableAnimation="True"
                                                            Fill="{x:Bind ViewModel.ChartColorBrush1, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartDisplayedData1, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartDisplayedLabel1, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                        <chart:ColumnSeries x:Name="ColumnFpsRenderedChart1Series"
                                                            EnableAnimation="True"
                                                            IsVisibleOnLegend="{x:Bind ViewModel.BarColumnRenderedVisible, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartRenderedData1, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartRenderedLabel1, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.Fill>
                                                <SolidColorBrush Color="{x:Bind ViewModel.ChartRenderedColor1, Mode=OneWay}" />
                                            </chart:ColumnSeries.Fill>
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                        <chart:ColumnSeries x:Name="ColumnFpsChart2Series"
                                                            EnableAnimation="True"
                                                            Fill="{x:Bind ViewModel.ChartColorBrush2, Mode=OneWay}"
                                                            IsVisibleOnLegend="{x:Bind ViewModel.HasSecondRecording, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartDisplayedData2, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartDisplayedLabel2, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                        <chart:ColumnSeries x:Name="ColumnFpsRenderedChart2Series"
                                                            EnableAnimation="True"
                                                            IsVisibleOnLegend="{x:Bind ViewModel.HasSecondRecording, Mode=OneWay}"
                                                            ItemsSource="{x:Bind ViewModel.BarColumnChartRenderedData2, Mode=OneWay}"
                                                            Label="{x:Bind ViewModel.BarColumnChartRenderedLabel2, Mode=OneWay}"
                                                            SegmentSpacing="0.2"
                                                            ShowDataLabels="True"
                                                            XBindingPath="Label"
                                                            YBindingPath="Value">
                                            <chart:ColumnSeries.Fill>
                                                <SolidColorBrush Color="{x:Bind ViewModel.ChartRenderedColor2, Mode=OneWay}" />
                                            </chart:ColumnSeries.Fill>
                                            <chart:ColumnSeries.DataLabelSettings>
                                                <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.BarColumnChartLabelFormat, Mode=OneWay}"
                                                                                  Position="Outer"
                                                                                  UseSeriesPalette="False" />
                                            </chart:ColumnSeries.DataLabelSettings>
                                        </chart:ColumnSeries>
                                    </chart:SfCartesianChart.Series>
                                </chart:SfCartesianChart>
                            </dev:Case>
                            <dev:Case Value="Line">
                                <chart:SfCartesianChart x:Name="LineFpsChart">
                                    <chart:SfCartesianChart.Legend>
                                        <chart:ChartLegend ToggleSeriesVisibility="True" />
                                    </chart:SfCartesianChart.Legend>

                                    <!--  X Axis (Frame Index)  -->
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:NumericalAxis EdgeLabelsDrawingMode="Shift"
                                                             Header="Frame Index"
                                                             Minimum="0" />
                                    </chart:SfCartesianChart.XAxes>

                                    <!--  Y Axis (Milliseconds)  -->
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis Header="{x:Bind ViewModel.LineScatterChartYAxisLabel, Mode=OneWay}" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:SfCartesianChart.TrackballBehavior>
                                        <chart:ChartTrackballBehavior />
                                    </chart:SfCartesianChart.TrackballBehavior>
                                    <chart:SfCartesianChart.ZoomPanBehavior>
                                        <chart:ChartZoomPanBehavior EnableMouseWheelZooming="True"
                                                                    EnablePanning="True"
                                                                    ZoomMode="XY" />
                                    </chart:SfCartesianChart.ZoomPanBehavior>
                                    <chart:SfCartesianChart.Series>
                                        <chart:FastLineSeries EnableAnimation="True"
                                                              Fill="{x:Bind ViewModel.ChartColorBrush1, Mode=OneWay}"
                                                              ItemsSource="{x:Bind ViewModel.LineScatterChartData1, Mode=OneWay}"
                                                              Label="{x:Bind ViewModel.LineScatterChartLabel1, Mode=OneWay}"
                                                              XBindingPath="Index"
                                                              YBindingPath="Value" />
                                        <chart:FastLineSeries EnableAnimation="True"
                                                              Fill="{x:Bind ViewModel.ChartColorBrush2, Mode=OneWay}"
                                                              IsVisibleOnLegend="{x:Bind ViewModel.HasSecondRecording, Mode=OneWay}"
                                                              ItemsSource="{x:Bind ViewModel.LineScatterChartData2, Mode=OneWay}"
                                                              Label="{x:Bind ViewModel.LineScatterChartLabel2, Mode=OneWay}"
                                                              XBindingPath="Index"
                                                              YBindingPath="Value" />
                                    </chart:SfCartesianChart.Series>
                                </chart:SfCartesianChart>
                            </dev:Case>
                            <dev:Case Value="Scatter">
                                <chart:SfCartesianChart x:Name="ScatterFpsChart">
                                    <chart:SfCartesianChart.Legend>
                                        <chart:ChartLegend ToggleSeriesVisibility="True" />
                                    </chart:SfCartesianChart.Legend>

                                    <!--  X Axis (Frame Index)  -->
                                    <chart:SfCartesianChart.XAxes>
                                        <chart:NumericalAxis EdgeLabelsDrawingMode="Shift"
                                                             Header="Frame Index"
                                                             Minimum="0" />
                                    </chart:SfCartesianChart.XAxes>

                                    <!--  Y Axis (Milliseconds)  -->
                                    <chart:SfCartesianChart.YAxes>
                                        <chart:NumericalAxis Header="{x:Bind ViewModel.LineScatterChartYAxisLabel, Mode=OneWay}" />
                                    </chart:SfCartesianChart.YAxes>
                                    <chart:SfCartesianChart.TrackballBehavior>
                                        <chart:ChartTrackballBehavior />
                                    </chart:SfCartesianChart.TrackballBehavior>
                                    <chart:SfCartesianChart.ZoomPanBehavior>
                                        <chart:ChartZoomPanBehavior EnableMouseWheelZooming="True"
                                                                    EnablePanning="True"
                                                                    ZoomMode="XY" />
                                    </chart:SfCartesianChart.ZoomPanBehavior>
                                    <chart:SfCartesianChart.Series>
                                        <chart:FastScatterBitmapSeries EnableAnimation="True"
                                                                       Fill="{x:Bind ViewModel.ChartColorBrush1, Mode=OneWay}"
                                                                       ItemsSource="{x:Bind ViewModel.LineScatterChartData1, Mode=OneWay}"
                                                                       Label="{x:Bind ViewModel.LineScatterChartLabel1, Mode=OneWay}"
                                                                       PointHeight="5"
                                                                       PointWidth="5"
                                                                       XBindingPath="Index"
                                                                       YBindingPath="Value" />
                                        <chart:FastScatterBitmapSeries EnableAnimation="True"
                                                                       Fill="{x:Bind ViewModel.ChartColorBrush2, Mode=OneWay}"
                                                                       IsVisibleOnLegend="{x:Bind ViewModel.HasSecondRecording, Mode=OneWay}"
                                                                       ItemsSource="{x:Bind ViewModel.LineScatterChartData2, Mode=OneWay}"
                                                                       Label="{x:Bind ViewModel.LineScatterChartLabel2, Mode=OneWay}"
                                                                       PointHeight="5"
                                                                       PointWidth="5"
                                                                       XBindingPath="Index"
                                                                       YBindingPath="Value" />
                                    </chart:SfCartesianChart.Series>
                                </chart:SfCartesianChart>
                            </dev:Case>
                        </dev:SwitchPresenter>
                    </dev:Case>

                    <!--  No Recordings  -->
                    <dev:Case Value="Empty">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Select up to two recordings to view analysis"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>

                    <!--  Too many Recordings  -->
                    <dev:Case Value="Error">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Too many recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Maximum of 2 recordings supported for analysis"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>
                </dev:SwitchPresenter>
            </dev:Case>

            <!--  Statistics  -->
            <dev:Case Value="Statistics">
                <dev:SwitchPresenter Value="{x:Bind ViewModel.StatisticsState, Mode=OneWay}">
                    <dev:Case Value="Content">

                        <!--  Statistics TreeGrid  -->
                        <sfgrid:SfTreeGrid x:Name="StatisticsTreeGrid"
                                           VerticalAlignment="Stretch"
                                           AutoExpandMode="AllNodesExpanded"
                                           AutoGenerateColumns="False"
                                           ChildPropertyName="Children"
                                           ColumnWidthMode="Star"
                                           ExpanderColumn="Metric"
                                           GridLinesVisibility="Both"
                                           HeaderLinesVisibility="Both"
                                           ItemsSource="{x:Bind ViewModel.StatisticsRows, Mode=OneWay}"
                                           SelectionMode="None"
                                           SizeChanged="StatisticsTreeGrid_SizeChanged">
                            <sfgrid:SfTreeGrid.ColumnSizer>
                                <common:TreeGridStarColumnSizer />
                            </sfgrid:SfTreeGrid.ColumnSizer>
                            <sfgrid:SfTreeGrid.Columns>

                                <!--  Metric  -->
                                <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="2"
                                                               HeaderText="Metric"
                                                               MappingName="Metric">
                                    <sfgrid:TreeGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="local:ResultRow">
                                            <TextBlock Margin="12,0"
                                                       VerticalAlignment="Center"
                                                       Text="{x:Bind Metric, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}" />
                                        </DataTemplate>
                                    </sfgrid:TreeGridTemplateColumn.CellTemplate>
                                </sfgrid:TreeGridTemplateColumn>

                                <!--  Recording A  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="1"
                                                           CellStyleSelector="{StaticResource RecordingACellStyleSelector}"
                                                           HeaderText="{x:Bind ViewModel.RecordingAHeader, Mode=OneWay}"
                                                           MappingName="RecordingA" />

                                <!--  Recording B  -->
                                <sfgrid:TreeGridTextColumn x:Name="StatisticsRecordingBColumn"
                                                           common:StarRatio.ColumnRatio="1"
                                                           CellStyleSelector="{StaticResource RecordingBCellStyleSelector}"
                                                           HeaderText="{x:Bind ViewModel.RecordingBHeader, Mode=OneWay}"
                                                           MappingName="RecordingB" />
                            </sfgrid:SfTreeGrid.Columns>
                        </sfgrid:SfTreeGrid>
                    </dev:Case>

                    <!--  No Recordings  -->
                    <dev:Case Value="Empty">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Select up to two recordings to view statistics"
                                       TextAlignment="Center" />

                        </StackPanel>
                    </dev:Case>

                    <!--  Too many Recordings  -->
                    <dev:Case Value="Error">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Too many recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Maximum of 2 recordings supported for statistics"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>
                </dev:SwitchPresenter>
            </dev:Case>
        </dev:SwitchPresenter>
    </Grid>
</Page>
