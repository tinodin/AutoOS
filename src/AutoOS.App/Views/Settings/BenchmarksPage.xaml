<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AutoOS.Views.Settings.BenchmarksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
      xmlns:common="using:AutoOS.Common"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:AutoOS.Views.Settings.Benchmarks"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:sfdata="using:Syncfusion.UI.Xaml.DataGrid"
      xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid"
      mc:Ignorable="d">
    <Page.Resources>
        <!--  Critical  -->
        <Style x:Key="CriticalCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>

        <!--  Success  -->
        <Style x:Key="SuccessCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>

        <!--  Cell style selector  -->
        <local:ResultCellStyleSelector x:Key="RecordingACellStyleSelector"
                                       CriticalStyle="{StaticResource CriticalCellStyle}"
                                       IsRecordingA="True"
                                       SuccessStyle="{StaticResource SuccessCellStyle}" />
        <local:ResultCellStyleSelector x:Key="RecordingBCellStyleSelector"
                                       CriticalStyle="{StaticResource CriticalCellStyle}"
                                       SuccessStyle="{StaticResource SuccessCellStyle}" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Margin="36,24,36,0">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                       Text="Benchmarks" />

            <!--  Command Bar  -->
            <controls:TabbedCommandBar x:Name="BenchmarksSelectorBar"
                                       Margin="0,48,0,0"
                                       SelectedItem="{x:Bind RecordingsTab}"
                                       SelectionChanged="BenchmarksSelectorBar_SelectionChanged">
                <controls:TabbedCommandBar.MenuItems>

                    <!--  Recordings  -->
                    <controls:TabbedCommandBarItem x:Name="RecordingsTab"
                                                   Header="Recordings">
                        <controls:TabbedCommandBarItem.PrimaryCommands>

                            <!--  Add Recordings  -->
                            <AppBarButton Click="AddRecording_Click"
                                          Icon="{dev:FontIcon Glyph=&#xE710;}"
                                          Label="Add Recordings"
                                          ToolTipService.ToolTip="Add existing recordings" />

                            <!--  Aggregate  -->
                            <AppBarButton x:Name="Aggregate"
                                          Click="Aggregate_Click"
                                          Icon="{dev:FontIcon Glyph=&#xEA3C;}"
                                          IsEnabled="{x:Bind ViewModel.IsAggregateEnabled, Mode=OneWay}"
                                          Label="Aggregate">
                            </AppBarButton>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Process  -->
                            <AppBarElementContainer>
                                <AutoSuggestBox x:Name="ProcessAutoSuggestBox"
                                                ItemsSource="{x:Bind ViewModel.ProcessSuggestions, Mode=OneWay}"
                                                MinWidth="200"
                                                GotFocus="ProcessAutoSuggestBox_GotFocus"
                                                PlaceholderText="Select a process..."
                                                SuggestionChosen="ProcessAutoSuggestBox_SuggestionChosen"
                                                Text="{x:Bind ViewModel.ProcessName, Mode=TwoWay}"
                                                TextChanged="ProcessAutoSuggestBox_TextChanged"
                                                ToolTipService.ToolTip="Process" />
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Duration  -->
                            <AppBarElementContainer>
                                <NumberBox x:Name="RecordingTimeBox"
                                           LargeChange="10"
                                           Minimum="3"
                                           PlaceholderText="Duration (s)"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="Duration (s)"
                                           Value="{x:Bind ViewModel.RecordingDuration, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <!--  Delay  -->
                            <AppBarElementContainer Margin="2,0">
                                <NumberBox x:Name="RecordingDelayBox"
                                           LargeChange="10"
                                           Minimum="0"
                                           PlaceholderText="Delay (s)"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Inline"
                                           ToolTipService.ToolTip="Delay (s)"
                                           Value="{x:Bind ViewModel.RecordingDelay, Mode=TwoWay}" />
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Hotkey  -->
                            <AppBarElementContainer>
                                <dev:Shortcut x:Name="HotkeyShortcut"
                                              Keys="{x:Bind ViewModel.ShortcutKeys, Mode=OneWay}"
                                              PrimaryButtonClick="HotkeyShortcut_PrimaryButtonClick"
                                              Style="{StaticResource SmallShortcutStyle}"
                                              UseAutoValidation="True" />
                            </AppBarElementContainer>

                            <!--  Record  -->
                            <AppBarToggleButton x:Name="Record"
                                                Checked="Record_Checked"
                                                Icon="{dev:FontIcon Glyph=&#xE7C8;}"
                                                IsEnabled="{x:Bind ViewModel.CanRecord, Mode=OneWay}"
                                                Label="{x:Bind ViewModel.RecordLabel, Mode=OneWay}"
                                                Unchecked="Record_Unchecked">
                            </AppBarToggleButton>

                        </controls:TabbedCommandBarItem.PrimaryCommands>
                    </controls:TabbedCommandBarItem>

                    <!--  Analysis  -->
                    <controls:TabbedCommandBarItem x:Name="AnalysisTab"
                                                   Header="Analysis">
                        <controls:TabbedCommandBarItem.PrimaryCommands>

                            <!--  Bar Chart Metric 1  -->
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Bar Chart Metric 1">
                                <ComboBox x:Name="FpsMetricComboBox"
                                          MinWidth="150"
                                          SelectedIndex="0"
                                          SelectionChanged="FpsMetricComboBox_SelectionChanged">
                                    <x:String>Displayed FPS</x:String>
                                    <x:String>Rendered FPS</x:String>
                                </ComboBox>
                            </AppBarElementContainer>

                            <!--  FPS / MS  -->
                            <AppBarElementContainer Margin="4,0,0,0"
                                                    IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Bar Chart Metric 2">
                                <dev:SelectorBarSegmented x:Name="FpsUnitSelector"
                                                          VerticalAlignment="Bottom"
                                                          SelectionChanged="FpsUnitSelector_SelectionChanged">
                                    <SelectorBarItem x:Name="FpsUnitItem"
                                                     IsSelected="True"
                                                     Text="FPS" />
                                    <SelectorBarItem x:Name="MsUnitItem"
                                                     Text="MS" />
                                </dev:SelectorBarSegmented>
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Line Chart Metric 2  -->
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Line Chart Metric 1">
                                <ComboBox x:Name="Metric1ComboBox"
                                          MinWidth="150"
                                          SelectedIndex="0"
                                          SelectionChanged="MetricComboBox_SelectionChanged">
                                    <x:String>Displayed FPS</x:String>
                                    <x:String>MsBetweenDisplayChange</x:String>
                                    <x:String>Rendered FPS</x:String>
                                    <x:String>MsBetweenPresents</x:String>
                                    <x:String>MsGPUBusy</x:String>
                                    <x:String>MsUntilDisplayed</x:String>
                                </ComboBox>
                            </AppBarElementContainer>

                            <!--  Separator  -->
                            <AppBarSeparator Margin="4,0" />

                            <!--  Recording A Color Picker  -->
                            <AppBarElementContainer IsEnabled="{x:Bind ViewModel.IsAnalysisToolbarEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Recording A Color">
                                <dev:DropdownColorPicker x:Name="HeaderFpsColorPicker"
                                                         VerticalAlignment="Bottom"
                                                         Background="{x:Bind ViewModel.FpsChartColor, Mode=OneWay}"
                                                         ColorSpectrumShape="Ring"
                                                         IsAlphaEnabled="True"
                                                         IsAlphaSliderVisible="True"
                                                         IsMoreButtonVisible="True"
                                                         Tag="RecordingA"
                                                         Color="{x:Bind ViewModel.FpsColor, Mode=TwoWay}">
                                </dev:DropdownColorPicker>
                            </AppBarElementContainer>
                            <!--  Recording B Color Picker  -->
                            <AppBarElementContainer Margin="4,0,0,0"
                                                    IsEnabled="{x:Bind ViewModel.IsSecondColorPickerEnabled, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Recording B Color">
                                <dev:DropdownColorPicker x:Name="HeaderFpsColorPicker2"
                                                         VerticalAlignment="Bottom"
                                                         Background="{x:Bind ViewModel.FpsChartColor2, Mode=OneWay}"
                                                         ColorSpectrumShape="Ring"
                                                         IsAlphaEnabled="True"
                                                         IsAlphaSliderVisible="True"
                                                         IsMoreButtonVisible="True"
                                                         Tag="RecordingB"
                                                         Color="{x:Bind ViewModel.FpsColor2, Mode=TwoWay}">
                                </dev:DropdownColorPicker>
                            </AppBarElementContainer>
                        </controls:TabbedCommandBarItem.PrimaryCommands>
                    </controls:TabbedCommandBarItem>

                    <!--  Results  -->
                    <controls:TabbedCommandBarItem x:Name="ResultsTab"
                                                   Header="Results" />
                </controls:TabbedCommandBar.MenuItems>
            </controls:TabbedCommandBar>
        </StackPanel>

        <dev:SwitchPresenter x:Name="PageSwitchPresenter"
                             Grid.Row="1"
                             Margin="36,8,36,36"
                             Value="{x:Bind ViewModel.ActiveTab, Mode=OneWay}">
            <!--  Recordings  -->
            <dev:Case Value="Recordings">
                <dev:SwitchPresenter x:Name="RecordingSwitchPresenter"
                                     Value="{x:Bind ViewModel.RecordingState, Mode=OneWay}">
                    <dev:Case Value="Content">

                        <!--  Recordings TreeGrid  -->
                        <sfgrid:SfTreeGrid x:Name="RecordingsTreeGrid"
                                           AllowEditing="True"
                                           AllowTriStateSorting="True"
                                           AutoGenerateColumns="False"
                                           ColumnWidthMode="Star"
                                           CurrentCellBorderThickness="0"
                                           CurrentCellEndEdit="RecordingsTreeGrid_CurrentCellEndEdit"
                                           GridLinesVisibility="Both"
                                           HeaderLinesVisibility="Both"
                                           ItemsSource="{x:Bind ViewModel.Recordings, Mode=OneWay}"
                                           NavigationMode="Cell"
                                           PasteOption="None"
                                           SelectionChanged="RecordingsTreeGrid_SelectionChanged"
                                           SelectionMode="Multiple"
                                           ShowToolTip="True"
                                           SizeChanged="RecordingsTreeGrid_SizeChanged">
                            <sfgrid:SfTreeGrid.ColumnSizer>
                                <common:TreeGridStarColumnSizer />
                            </sfgrid:SfTreeGrid.ColumnSizer>
                            <sfgrid:SfTreeGrid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="DeleteRecordingFlyoutItem_Click"
                                                    Text="Delete" />
                                </MenuFlyout>
                            </sfgrid:SfTreeGrid.ContextFlyout>
                            <sfgrid:SfTreeGrid.Columns>

                                <!--  Title  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="5"
                                                           AllowEditing="True"
                                                           HeaderText="Title"
                                                           MappingName="Title"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Process  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                                           HeaderText="Process"
                                                           IsReadOnly="True"
                                                           MappingName="Process"
                                                           MinimumWidth="80"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Duration  -->
                                <sfgrid:TreeGridNumericColumn common:StarRatio.ColumnRatio="1"
                                                              DisplayNumberFormat="0.# s"
                                                              HeaderText="Duration"
                                                              IsReadOnly="True"
                                                              MappingName="DurationSeconds"
                                                              MinimumWidth="70"
                                                              ShowToolTip="True"
                                                              TextTrimming="CharacterEllipsis"
                                                              TextWrapping="NoWrap" />

                                <!--  Date  -->
                                <sfgrid:TreeGridDateColumn common:StarRatio.ColumnRatio="1"
                                                           DisplayDateFormat="dd/MM/yyyy"
                                                           HeaderText="Date"
                                                           IsReadOnly="True"
                                                           MappingName="Date"
                                                           MinimumWidth="100"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Time  -->
                                <sfgrid:TreeGridTimeColumn common:StarRatio.ColumnRatio="1"
                                                           DisplayTimeFormat="HH:mm"
                                                           HeaderText="Time"
                                                           IsReadOnly="True"
                                                           MappingName="Time"
                                                           MinimumWidth="80"
                                                           ShowToolTip="True"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                <!--  Size  -->
                                <sfgrid:TreeGridNumericColumn common:StarRatio.ColumnRatio="1"
                                                              DisplayNumberFormat="0.# KB"
                                                              HeaderText="File Size"
                                                              IsReadOnly="True"
                                                              MappingName="FileSizeKb"
                                                              MinimumWidth="80"
                                                              ShowToolTip="True"
                                                              TextTrimming="CharacterEllipsis"
                                                              TextWrapping="NoWrap" />
                            </sfgrid:SfTreeGrid.Columns>
                        </sfgrid:SfTreeGrid>
                    </dev:Case>

                    <!--  No Recordings  -->
                    <dev:Case Value="Empty">
                        <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Glyph="&#xE9F9;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No recordings found"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>

                </dev:SwitchPresenter>
            </dev:Case>

            <!--  Analysis  -->
            <dev:Case Value="Analysis">
                <dev:SwitchPresenter x:Name="AnalysisSwitchPresenter"
                                     Value="{x:Bind ViewModel.AnalysisState, Mode=OneWay}">
                    <dev:Case Value="Content">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  Bar Chart 1  -->
                                    <chart:SfCartesianChart x:Name="FpsChart"
                                                            Grid.Row="1"
                                                            IsTransposed="True">
                                        <chart:SfCartesianChart.Legend>
                                            <chart:ChartLegend />
                                        </chart:SfCartesianChart.Legend>
                                        <chart:SfCartesianChart.XAxes>
                                            <chart:CategoryAxis ShowMajorGridLines="False" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>
                                            <chart:NumericalAxis x:Name="FpsChartYAxis"
                                                                 EdgeLabelsDrawingMode="Shift"
                                                                 Header="{x:Bind ViewModel.FpsChartYAxisLabel, Mode=OneWay}"
                                                                 RangePadding="AppendInterval"
                                                                 ShowMajorGridLines="True" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:SfCartesianChart.Series>
                                            <chart:ColumnSeries x:Name="FpsChart1Series"
                                                                EnableAnimation="True"
                                                                Fill="{x:Bind ViewModel.FpsChartColor, Mode=OneWay}"
                                                                ItemsSource="{x:Bind ViewModel.FpsBarSeries, Mode=OneWay}"
                                                                Label="{x:Bind ViewModel.FpsChartLabel, Mode=OneWay}"
                                                                SegmentSpacing="0.2"
                                                                ShowDataLabels="True"
                                                                XBindingPath="Label"
                                                                YBindingPath="Value">
                                                <chart:ColumnSeries.DataLabelSettings>
                                                    <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.FpsChartLabelFormat, Mode=OneWay}"
                                                                                      Position="Outer"
                                                                                      UseSeriesPalette="False" />
                                                </chart:ColumnSeries.DataLabelSettings>
                                            </chart:ColumnSeries>
                                            <chart:ColumnSeries x:Name="FpsChart2Series"
                                                                EnableAnimation="True"
                                                                Fill="{x:Bind ViewModel.FpsChartColor2, Mode=OneWay}"
                                                                IsSeriesVisible="{x:Bind ViewModel.ShowFpsChart2, Mode=OneWay}"
                                                                IsVisibleOnLegend="{x:Bind ViewModel.ShowFpsChart2, Mode=OneWay}"
                                                                ItemsSource="{x:Bind ViewModel.FpsBarSeries2, Mode=OneWay}"
                                                                Label="{x:Bind ViewModel.FpsChartLabel2, Mode=OneWay}"
                                                                SegmentSpacing="0.2"
                                                                ShowDataLabels="{x:Bind ViewModel.ShowFpsChart2, Mode=OneWay}"
                                                                XBindingPath="Label"
                                                                YBindingPath="Value">
                                                <chart:ColumnSeries.DataLabelSettings>
                                                    <chart:CartesianDataLabelSettings Format="{x:Bind ViewModel.FpsChartLabelFormat, Mode=OneWay}"
                                                                                      Position="Outer"
                                                                                      UseSeriesPalette="False" />
                                                </chart:ColumnSeries.DataLabelSettings>
                                            </chart:ColumnSeries>
                                        </chart:SfCartesianChart.Series>
                                    </chart:SfCartesianChart>
                                </Grid>

                                <Grid Grid.Row="1">

                                    <!--  Line Chart 2  -->
                                    <chart:SfCartesianChart x:Name="MetricChart">
                                        <chart:SfCartesianChart.Legend>
                                            <chart:ChartLegend />
                                        </chart:SfCartesianChart.Legend>
                                        <chart:SfCartesianChart.XAxes>

                                            <!--  Frame Index  -->
                                            <chart:NumericalAxis EdgeLabelsDrawingMode="Shift"
                                                                 Header="Frame Index"
                                                                 Minimum="0" />
                                        </chart:SfCartesianChart.XAxes>
                                        <chart:SfCartesianChart.YAxes>

                                            <!--  Line Chart Metric 2  -->
                                            <chart:NumericalAxis Header="{x:Bind ViewModel.MetricChartYAxisLabel, Mode=OneWay}" />
                                        </chart:SfCartesianChart.YAxes>
                                        <chart:SfCartesianChart.TrackballBehavior>
                                            <chart:ChartTrackballBehavior />
                                        </chart:SfCartesianChart.TrackballBehavior>
                                        <chart:SfCartesianChart.ZoomPanBehavior>
                                            <chart:ChartZoomPanBehavior EnableMouseWheelZooming="True"
                                                                        EnablePanning="True"
                                                                        ZoomMode="XY" />
                                        </chart:SfCartesianChart.ZoomPanBehavior>
                                        <chart:SfCartesianChart.Series>
                                            <chart:LineSeries x:Name="MetricChart1Series"
                                                              EnableAnimation="True"
                                                              Fill="{x:Bind ViewModel.FpsChartColor, Mode=OneWay}"
                                                              ItemsSource="{x:Bind ViewModel.MetricLineSeries, Mode=OneWay}"
                                                              Label="{x:Bind ViewModel.MetricChartLabel, Mode=OneWay}"
                                                              XBindingPath="Index"
                                                              YBindingPath="Value" />
                                            <chart:LineSeries x:Name="MetricChart2Series"
                                                              EnableAnimation="True"
                                                              Fill="{x:Bind ViewModel.FpsChartColor2, Mode=OneWay}"
                                                              IsSeriesVisible="{x:Bind ViewModel.ShowMetricChart2, Mode=OneWay}"
                                                              IsVisibleOnLegend="{x:Bind ViewModel.ShowMetricChart2, Mode=OneWay}"
                                                              ItemsSource="{x:Bind ViewModel.MetricLineSeries2, Mode=OneWay}"
                                                              Label="{x:Bind ViewModel.MetricChartLabel2, Mode=OneWay}"
                                                              XBindingPath="Index"
                                                              YBindingPath="Value" />
                                        </chart:SfCartesianChart.Series>
                                    </chart:SfCartesianChart>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </dev:Case>

                    <!--  No Recordings  -->
                    <dev:Case Value="Empty">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Select up to two recordings to view analysis"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>

                    <!--  Too many Recordings  -->
                    <dev:Case Value="Error">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Too many recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Maximum of 2 recordings supported for analysis"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>
                </dev:SwitchPresenter>
            </dev:Case>

            <!--  Results  -->
            <dev:Case Value="Results">
                <dev:SwitchPresenter x:Name="ResultsSwitchPresenter"
                                     Value="{x:Bind ViewModel.ResultsState, Mode=OneWay}">
                    <dev:Case Value="Content">

                        <!--  Results TreeGrid  -->
                        <sfgrid:SfTreeGrid x:Name="ResultsTreeGrid"
                                           VerticalAlignment="Stretch"
                                           AutoExpandMode="AllNodesExpanded"
                                           AutoGenerateColumns="False"
                                           ChildPropertyName="Children"
                                           ColumnWidthMode="Star"
                                           ExpanderColumn="Metric"
                                           GridLinesVisibility="Both"
                                           HeaderLinesVisibility="Both"
                                           ItemsSource="{x:Bind ViewModel.ResultsRows, Mode=OneWay}"
                                           SizeChanged="ResultsTreeGrid_SizeChanged">
                            <sfgrid:SfTreeGrid.ColumnSizer>
                                <common:TreeGridStarColumnSizer />
                            </sfgrid:SfTreeGrid.ColumnSizer>
                            <sfgrid:SfTreeGrid.Columns>

                                <!--  Metric  -->
                                <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="4"
                                                           HeaderText="Metric"
                                                           MappingName="Metric" />

                                <!--  Recording A  -->
                                <sfgrid:TreeGridTextColumn x:Name="RecordingAColumn"
                                                           common:StarRatio.ColumnRatio="3"
                                                           CellStyleSelector="{StaticResource RecordingACellStyleSelector}"
                                                           HeaderText="{x:Bind ViewModel.RecordingAHeader, Mode=OneWay}"
                                                           MappingName="RecordingA" />

                                <!--  Recording B  -->
                                <sfgrid:TreeGridTextColumn x:Name="RecordingBColumn"
                                                           common:StarRatio.ColumnRatio="3"
                                                           CellStyleSelector="{StaticResource RecordingBCellStyleSelector}"
                                                           HeaderText="{x:Bind ViewModel.RecordingBHeader, Mode=OneWay}"
                                                           MappingName="RecordingB" />
                            </sfgrid:SfTreeGrid.Columns>
                        </sfgrid:SfTreeGrid>
                    </dev:Case>

                    <!--  No Recordings  -->
                    <dev:Case Value="Empty">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Select up to two recordings to view results"
                                       TextAlignment="Center" />

                        </StackPanel>
                    </dev:Case>

                    <!--  Too many Recordings  -->
                    <dev:Case Value="Error">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <FontIcon HorizontalAlignment="Center"
                                      FontSize="48"
                                      Foreground="{ThemeResource SystemFillColorCritical}"
                                      Glyph="&#xE783;" />
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Too many recordings selected"
                                       TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Maximum of 2 recordings supported for results"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </dev:Case>
                </dev:SwitchPresenter>
            </dev:Case>
        </dev:SwitchPresenter>
    </Grid>
</Page>
