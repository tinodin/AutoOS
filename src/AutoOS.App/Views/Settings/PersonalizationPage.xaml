<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="AutoOS.Views.Settings.PersonalizationPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dev="using:DevWinUI"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock
			Margin="36,24,0,0"
			Style="{StaticResource TitleTextBlockStyle}"
			Text="Personalization" />
		<ScrollViewer
			Grid.Row="1"
			VerticalScrollBarVisibility="Auto"
			VerticalScrollMode="Auto">
			<StackPanel
				Margin="{ThemeResource ContentPageMargin}"
				Padding="{ThemeResource ContentPagePadding}"
				dev:PanelAttach.ChildrenTransitions="Default">
				<dev:Card
					Margin="0,-32,0,16"
					Padding="0">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Border
							x:Name="PreviewLightRoot"
							Grid.Column="0"
							Margin="0,0,6,0"
							Height="140"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="2"
							CornerRadius="12">
							<Border.Background>
								<ImageBrush
									x:Name="PreviewLightBrush"
									Stretch="UniformToFill" />
							</Border.Background>
							<Grid VerticalAlignment="Top">
								<Border
									Background="White"
									CornerRadius="10,10,0,0"
									Height="24">
									<Border
										Width="6"
										Height="6"
										Margin="10,0,0,0"
										Background="Black"
										CornerRadius="3"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Opacity="0.15" />
								</Border>
							</Grid>
						</Border>
						<Border
							x:Name="PreviewDarkRoot"
							Grid.Column="1"
							Margin="6,0,0,0"
							Height="140"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="2"
							CornerRadius="12">
							<Border.Background>
								<ImageBrush
									x:Name="PreviewDarkBrush"
									Stretch="UniformToFill" />
							</Border.Background>
							<Grid VerticalAlignment="Top">
								<Border
									Background="#1C1C1C"
									CornerRadius="10,10,0,0"
									Height="24">
									<Border
										Width="6"
										Height="6"
										Margin="10,0,0,0"
										Background="White"
										CornerRadius="3"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Opacity="0.15" />
								</Border>
							</Grid>
						</Border>
					</Grid>
				</dev:Card>
				<dev:SimpleSettingsGroup Margin="0,-16,0,0" Header="Auto Theme Switcher">
					<dev:SettingsCard
						Header="Scheduling Mode"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE823;}">
						<ComboBox
							x:Name="ScheduleMode"
							MinWidth="320"
							SelectionChanged="ScheduleMode_SelectionChanged">
							<ComboBoxItem Content="Disabled" Tag="Disabled" />
							<ComboBoxItem Content="Custom" Tag="Custom" />
							<ComboBoxItem Content="Sunset to sunrise (location service)" Tag="LocationService" />
							<ComboBoxItem Content="Sunset to sunrise (custom coordinates)" Tag="CustomCoordinates" />
							<ComboBoxItem Content="Hotkey only" Tag="Hotkey" />
						</ComboBox>
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="LightTimeCard"
						Header="Light mode time"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE706;}"
						Visibility="Collapsed">
						<TimePicker
							x:Name="LightTime"
							ClockIdentifier="24HourClock"
							TimeChanged="LightMode_TimeChanged" />
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="DarkTimeCard"
						Header="Dark mode time"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE708;}"
						Visibility="Collapsed">
						<TimePicker
							x:Name="DarkTime"
							ClockIdentifier="24HourClock"
							TimeChanged="DarkMode_TimeChanged" />
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="LatitudeCard"
						Header="Latitude"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE787;}"
						Visibility="Collapsed">
						<NumberBox
							x:Name="Latitude"
							Maximum="90"
							Minimum="-90"
							PlaceholderText="0"
							SpinButtonPlacementMode="Inline"
							ValueChanged="Coordinate_ValueChanged" />
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="LongitudeCard"
						Header="Longitude"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE787;}"
						Visibility="Collapsed">
						<NumberBox
							x:Name="Longitude"
							Maximum="180"
							Minimum="-180"
							PlaceholderText="0"
							SpinButtonPlacementMode="Inline"
							ValueChanged="Coordinate_ValueChanged" />
					</dev:SettingsCard>
					<dev:Card
						x:Name="TimelineCard"
						Padding="24,-24,24,12"
						BorderThickness="1,1,1,0"
						CornerRadius="0"
						Visibility="Collapsed">
						<dev:Timeline x:Name="TimeLine" />
					</dev:Card>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Header="Switching">
					<dev:SettingsCard
						Header="Switching Mode"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE895;}">
						<ComboBox
							x:Name="SwitchMode"
							MinWidth="320"
							SelectionChanged="SwitchMode_SelectionChanged">
							<ComboBoxItem Content="Switch between light and dark appearance" Tag="Appearance" />
							<ComboBoxItem Content="Switch between light and dark appearance + wallpapers" Tag="Wallpaper" />
							<ComboBoxItem Content="Switch between light and dark themes" Tag="Theme" />
						</ComboBox>
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="LightWallpaperCard"
						Header="Light mode wallpaper"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE91B;}"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBox
								x:Name="LightWallpaper"
								MinWidth="320"
								PlaceholderText="Path to the light wallpaper image..."
								TextChanged="PathBox_TextChanged" />
							<Button Click="BrowseLightWallpaper_Click" Content="Browse" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="DarkWallpaperCard"
						Header="Dark mode wallpaper"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE91B;}"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBox
								x:Name="DarkWallpaper"
								MinWidth="320"
								PlaceholderText="Path to the dark wallpaper image..."
								TextChanged="PathBox_TextChanged" />
							<Button Click="BrowseDarkWallpaper_Click" Content="Browse" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="LightThemeCard"
						Header="Light mode theme"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE790;}"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBox
								x:Name="LightTheme"
								MinWidth="320"
								PlaceholderText="Path to the light .theme file..."
								TextChanged="PathBox_TextChanged" />
							<Button Click="BrowseLightTheme_Click" Content="Browse" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard
						x:Name="DarkThemeCard"
						Header="Dark mode theme"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE790;}"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBox
								x:Name="DarkTheme"
								MinWidth="320"
								PlaceholderText="Path to the dark .theme file..."
								TextChanged="PathBox_TextChanged" />
							<Button Click="BrowseDarkTheme_Click" Content="Browse" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard
						Description="A script or executable that runs on every switch, with a -light or -dark argument."
						Header="Custom script"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8A5;}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBox
								x:Name="ScriptPath"
								MinWidth="320"
								PlaceholderText="Path to the script or executable..."
								TextChanged="PathBox_TextChanged" />
							<Button Click="BrowseScript_Click" Content="Browse" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard
						Description="Apply the current wallpaper to the lock screen whenever the wallpaper changes."
						Header="Lock screen"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE756;}">
						<ToggleSwitch
							x:Name="LockScreen"
							OffContent="Disabled"
							OnContent="Enabled"
							Toggled="LockScreen_Toggled" />
					</dev:SettingsCard>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Header="Hotkey">
					<dev:SettingsCard
						Description="Press a combination of keys to manually toggle the current theme."
						Header="Toggle theme hotkey"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE70F;}">
						<dev:Shortcut
							x:Name="HotkeyShortcut"
							PrimaryButtonClick="HotkeyShortcut_PrimaryButtonClick"
							UseAutoValidation="True" />
					</dev:SettingsCard>
				</dev:SimpleSettingsGroup>
				<InfoBar
					x:Name="StatusInfo"
					Margin="0,0,0,36"
					IsClosable="True"
					IsOpen="False" />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
