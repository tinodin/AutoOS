<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="AutoOS.App.Views.Settings.DiskCleanupPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:analyzer="using:AutoOS.Core.Services.DiskAnalyzer"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:converters="using:AutoOS.App.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:data="using:Syncfusion.UI.Xaml.Data"
	xmlns:dev="using:DevWinUI"
	xmlns:ext="using:AutoOS.App.Extensions"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid"
	xmlns:tmap="using:AutoOS.App.UserControls.Treemap"
	xmlns:treegrid="using:AutoOS.App.Helpers.TreeGrid"
	xmlns:uc="using:AutoOS.App.UserControls"
	xmlns:vm="using:AutoOS.App.ViewModels"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
		<converters:ExtensionToColorBrushConverter x:Key="ExtensionToColorBrushConverter" />
		<!--  Numeric-aware sort comparers so Size/Allocated/Percent sort by value, not display text  -->
		<treegrid:TreeGridSortComparer x:Key="NameComparer" PropertyName="Name" />
		<treegrid:TreeGridSortComparer x:Key="PercentOfParentComparer" PropertyName="PercentOfParent" />
		<treegrid:TreeGridSortComparer x:Key="SizeComparer" PropertyName="Size" />
		<treegrid:TreeGridSortComparer x:Key="AllocatedComparer" PropertyName="Allocated" />
		<treegrid:TreeGridSortComparer x:Key="ItemsCountComparer" PropertyName="ItemsCount" />
		<treegrid:TreeGridSortComparer x:Key="FileCountComparer" PropertyName="FileCount" />
		<treegrid:TreeGridSortComparer x:Key="FolderCountComparer" PropertyName="FolderCount" />
		<treegrid:TreeGridSortComparer x:Key="ModifiedComparer" PropertyName="Modified" />
		<treegrid:TreeGridSortComparer x:Key="AttributesComparer" PropertyName="Attributes" />
		<treegrid:TreeGridSortComparer x:Key="FileNameComparer" PropertyName="FileName" />
		<treegrid:TreeGridSortComparer x:Key="DirectoryComparer" PropertyName="Directory" />
		<treegrid:TreeGridSortComparer x:Key="PercentOfDriveComparer" PropertyName="PercentOfDrive" />
		<treegrid:TreeGridSortComparer x:Key="DupCountComparer" PropertyName="DupCount" />
		<treegrid:TreeGridSortComparer x:Key="DupSizeComparer" PropertyName="DupSize" />
		<treegrid:TreeGridSortComparer x:Key="ExtensionComparer" PropertyName="Extension" />
		<treegrid:TreeGridSortComparer x:Key="FileTypeComparer" PropertyName="FileType" />
		<treegrid:TreeGridSortComparer x:Key="PercentComparer" PropertyName="Percent" />
		<treegrid:TreeGridSortComparer x:Key="FilesComparer" PropertyName="Files" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<StackPanel
			Grid.Row="0"
			Margin="36,24,36,0"
			Spacing="12">
			<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Disk Cleanup" />

			<ItemsRepeater ItemsSource="{x:Bind ViewModel.Drives, Mode=OneWay}">
				<ItemsRepeater.Layout>
					<controls:StaggeredLayout
						ColumnSpacing="8"
						DesiredColumnWidth="260"
						RowSpacing="8" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate x:DataType="vm:DriveModelLite">
						<Border
							Padding="12"
							Background="{ThemeResource SettingsCardBackground}"
							BorderBrush="{ThemeResource SettingsCardBorderBrush}"
							BorderThickness="1"
							CornerRadius="{StaticResource ControlCornerRadius}">
							<Grid ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<FontIcon
									Grid.Column="0"
									VerticalAlignment="Center"
									Glyph="&#xEDA2;" />
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Label, Mode=OneTime}" />
									<dev:StorageBar
										Padding="0,4,4,4"
										Maximum="{x:Bind TotalBytesDouble, Mode=OneTime}"
										PercentCaution="90"
										PercentCritical="95"
										TrackBarHeight="2"
										ValueBarHeight="4"
										Value="{x:Bind UsedBytesDouble, Mode=OneTime}" />
									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="{x:Bind FreeText, Mode=OneTime}" />
								</StackPanel>
								<Button
									Grid.Column="2"
									VerticalAlignment="Center"
									Click="DriveScan_Click"
									CommandParameter="{x:Bind Mode=OneTime}"
									Content="Scan"
									Style="{StaticResource AccentButtonStyle}" />
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>
		</StackPanel>

		<!--  Tab switch only (Tree View has no commandbar)  -->
		<dev:SelectorBarSegmented
			x:Name="DiskCleanupViewSelector"
			Grid.Row="1"
			Margin="36,16,36,0"
			HorizontalAlignment="Left"
			SelectionChanged="DiskCleanupViewSelector_SelectionChanged">
			<SelectorBarItem
				x:Name="TreeViewSegment"
				IsSelected="True"
				Text="Tree View" />
			<SelectorBarItem x:Name="FileViewSegment" Text="File View" />
		</dev:SelectorBarSegmented>

		<!--  File View toolbar card (BiosPage pattern, File View only)  -->
		<Border
			Grid.Row="2"
			Margin="36,8,36,0"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="{ThemeResource OverlayCornerRadius}"
			Visibility="{x:Bind ViewModel.FileToolbarVisibility, Mode=OneWay}">

			<CommandBar
				ext:CommandBarExtensions.ApplyOverflowIndent="True"
				ext:CommandBarExtensions.CommandAlignment="Left"
				ext:CommandBarExtensions.OverflowButtonAlignment="Right"
				DefaultLabelPosition="Right">

				<!--  Max Files  -->
				<!--
					Containers carry a 12px leading margin: AppBarButton pads its content by 12px internally,
					so plain content gets the same rhythm against the 4px separators (BiosPage spacing).
				-->
				<AppBarElementContainer Margin="12,0" VerticalContentAlignment="Center">
					<StackPanel
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Spacing="8">
						<TextBlock VerticalAlignment="Center" Text="Max files to display:" />
						<ComboBox Width="110" SelectedValue="{x:Bind ViewModel.MaxFilesToDisplay, Mode=TwoWay}">
							<x:Double>100</x:Double>
							<x:Double>500</x:Double>
							<x:Double>1000</x:Double>
							<x:Double>5000</x:Double>
							<x:Double>10000</x:Double>
						</ComboBox>
					</StackPanel>
				</AppBarElementContainer>

				<!--  Separator  -->
				<AppBarSeparator Margin="4,0" />

				<!--  Folders  -->
				<AppBarElementContainer Margin="12,0" VerticalContentAlignment="Center">
					<CheckBox
						MinWidth="0"
						Content="Folders"
						IsChecked="{x:Bind ViewModel.IncludeFoldersInFileView, Mode=TwoWay}" />
				</AppBarElementContainer>

				<!--  Separator  -->
				<AppBarSeparator Margin="4,0" />

				<!--  Duplicate Files  -->
				<AppBarElementContainer Margin="12,0" VerticalContentAlignment="Center">
					<StackPanel
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Spacing="8">
						<TextBlock VerticalAlignment="Center" Text="Duplicate Files:" />
						<ComboBox MinWidth="190" SelectedIndex="0">
							<ComboBoxItem Content="Locate by Name, Size, Date" />
							<ComboBoxItem Content="Locate by Name and Size" />
							<ComboBoxItem Content="Locate by Name" />
						</ComboBox>
					</StackPanel>
				</AppBarElementContainer>

				<!--  Separator  -->
				<AppBarSeparator Margin="4,0" />

				<!--  Duplicates Only  -->
				<AppBarElementContainer Margin="12,0" VerticalContentAlignment="Center">
					<CheckBox
						MinWidth="0"
						Content="Duplicates only"
						IsChecked="{x:Bind ViewModel.DuplicatesOnly, Mode=TwoWay}" />
				</AppBarElementContainer>
			</CommandBar>
		</Border>

		<dev:SwitchPresenter
			Grid.Row="3"
			Margin="36,8,36,36"
			Value="{x:Bind ViewModel.ActiveTab, Mode=OneWay}">

			<!--  Tree View: folder treegrid + extension breakdown (WizTree layout)  -->
			<dev:Case Value="TreeView">
				<Grid RowSpacing="6">
					<Grid.RowDefinitions>
						<RowDefinition Height="2*" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Visibility="{x:Bind ViewModel.TreeResultsVisibility, Mode=OneWay}">
						<Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.4*" />
								<ColumnDefinition Width="1*" />
							</Grid.ColumnDefinitions>

							<!--  Folder treegrid: Folder | % of Parent | Size | Allocated | Items | Files | Folders | Modified | Attributes  -->
							<sfgrid:SfTreeGrid
								x:Name="TreeGrid"
								Grid.Column="0"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								treegrid:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
								AllowEditing="False"
								AllowSorting="True"
								AllowTriStateSorting="True"
								AutoExpandMode="RootNodesExpanded"
								AutoGenerateColumns="False"
								CellToolTipOpening="TreeGrid_CellToolTipOpening"
								ChildPropertyName="Children"
								ColumnWidthMode="Star"
								DoubleTapped="Grid_DoubleTapped"
								ExpandStateMappingName="IsExpanded"
								FilterLevel="All"
								GridLinesVisibility="Both"
								HeaderLinesVisibility="Both"
								ItemsSource="{x:Bind ViewModel.TreeNodes, Mode=OneWay}"
								Loaded="TreeGrid_Loaded"
								NavigationMode="Row"
								RightTapped="Grid_RightTapped"
								SelectionMode="Single"
								ShowToolTip="True"
								SizeChanged="TreeGrid_SizeChanged">
								<sfgrid:SfTreeGrid.HeaderContextFlyout>
									<MenuFlyout />
								</sfgrid:SfTreeGrid.HeaderContextFlyout>
								<sfgrid:SfTreeGrid.ColumnSizer>
									<treegrid:TreeGridStarColumnSizer />
								</sfgrid:SfTreeGrid.ColumnSizer>
								<sfgrid:SfTreeGrid.SortComparers>
									<data:SortComparer Comparer="{StaticResource NameComparer}" PropertyName="Name" />
									<data:SortComparer Comparer="{StaticResource PercentOfParentComparer}" PropertyName="PercentOfParent" />
									<data:SortComparer Comparer="{StaticResource SizeComparer}" PropertyName="Size" />
									<data:SortComparer Comparer="{StaticResource AllocatedComparer}" PropertyName="Allocated" />
									<data:SortComparer Comparer="{StaticResource ItemsCountComparer}" PropertyName="ItemsCount" />
									<data:SortComparer Comparer="{StaticResource FileCountComparer}" PropertyName="FileCount" />
									<data:SortComparer Comparer="{StaticResource FolderCountComparer}" PropertyName="FolderCount" />
									<data:SortComparer Comparer="{StaticResource ModifiedComparer}" PropertyName="Modified" />
									<data:SortComparer Comparer="{StaticResource AttributesComparer}" PropertyName="Attributes" />
								</sfgrid:SfTreeGrid.SortComparers>
								<sfgrid:SfTreeGrid.Columns>
									<sfgrid:TreeGridTextColumn
										treegrid:StarRatio.ColumnRatio="1.8"
										HeaderText="Folder"
										MappingName="Name"
										TextTrimming="CharacterEllipsis" />
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="1.1"
										AllowSorting="True"
										HeaderText="% of Parent"
										MappingName="PercentOfParent">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel
													Margin="12,0"
													VerticalAlignment="Center"
													Orientation="Horizontal"
													Spacing="6">
													<ProgressBar
														Width="44"
														Height="10"
														VerticalAlignment="Center"
														Maximum="100"
														Minimum="0"
														Value="{Binding PercentOfParent}" />
													<TextBlock
														VerticalAlignment="Center"
														Text="{Binding PercentOfParentText}"
														TextAlignment="Right" />
												</StackPanel>
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.85"
										AllowSorting="True"
										HeaderText="Size"
										MappingName="Size">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="12,0"
													VerticalAlignment="Center"
													Text="{Binding SizeText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.85"
										AllowSorting="True"
										HeaderText="Allocated"
										MappingName="Allocated">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="12,0"
													VerticalAlignment="Center"
													Text="{Binding AllocatedText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.60"
										AllowSorting="True"
										HeaderText="Items"
										MappingName="ItemsCount">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="12,0"
													VerticalAlignment="Center"
													Text="{Binding ItemsText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.60"
										AllowSorting="True"
										HeaderText="Files"
										MappingName="FileCount">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="12,0"
													VerticalAlignment="Center"
													Text="{Binding FilesText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.60"
										AllowSorting="True"
										HeaderText="Folders"
										MappingName="FolderCount">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="12,0"
													VerticalAlignment="Center"
													Text="{Binding FoldersText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="1.0"
										AllowSorting="True"
										HeaderText="Modified"
										MappingName="Modified">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="12,0"
													VerticalAlignment="Center"
													Text="{Binding Modified, Converter={StaticResource DateTimeToStringConverter}}"
													TextTrimming="CharacterEllipsis" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTextColumn
										treegrid:StarRatio.ColumnRatio="0.65"
										HeaderText="Attributes"
										MappingName="Attributes"
										TextTrimming="CharacterEllipsis" />
								</sfgrid:SfTreeGrid.Columns>
							</sfgrid:SfTreeGrid>

							<!--  Extension breakdown: Extension | File Type | Percent | Size | Allocated | Files  -->
							<sfgrid:SfTreeGrid
								x:Name="ExtensionGrid"
								Grid.Column="1"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								AllowEditing="False"
								AllowSorting="True"
								AllowTriStateSorting="True"
								AutoGenerateColumns="False"
								ChildPropertyName="Children"
								ColumnWidthMode="Star"
								GridLinesVisibility="Both"
								HeaderLinesVisibility="Both"
								ItemsSource="{x:Bind ViewModel.ExtensionStats, Mode=OneWay}"
								Loaded="TreeGrid_Loaded"
								NavigationMode="Row"
								SelectionMode="Single"
								SizeChanged="TreeGrid_SizeChanged">
								<sfgrid:SfTreeGrid.ColumnSizer>
									<treegrid:TreeGridStarColumnSizer />
								</sfgrid:SfTreeGrid.ColumnSizer>
								<sfgrid:SfTreeGrid.SortComparers>
									<data:SortComparer Comparer="{StaticResource ExtensionComparer}" PropertyName="Extension" />
									<data:SortComparer Comparer="{StaticResource FileTypeComparer}" PropertyName="FileType" />
									<data:SortComparer Comparer="{StaticResource PercentComparer}" PropertyName="Percent" />
									<data:SortComparer Comparer="{StaticResource SizeComparer}" PropertyName="Size" />
									<data:SortComparer Comparer="{StaticResource AllocatedComparer}" PropertyName="Allocated" />
									<data:SortComparer Comparer="{StaticResource FilesComparer}" PropertyName="Files" />
								</sfgrid:SfTreeGrid.SortComparers>
								<sfgrid:SfTreeGrid.Columns>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.75"
										AllowSorting="True"
										HeaderText="Extension"
										MappingName="Extension"
										MinimumWidth="80">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate x:DataType="analyzer:DiskExtensionStat">
												<Grid Margin="8,0" VerticalAlignment="Center">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<Border
														Width="12"
														Height="12"
														Margin="0,0,8,0"
														Background="{Binding Extension, Converter={StaticResource ExtensionToColorBrushConverter}}"
														CornerRadius="2" />
													<TextBlock
														Grid.Column="1"
														VerticalAlignment="Center"
														Text="{Binding Extension}"
														TextTrimming="CharacterEllipsis" />
												</Grid>
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTextColumn
										treegrid:StarRatio.ColumnRatio="0.95"
										HeaderText="File Type"
										MappingName="FileType"
										MinimumWidth="100"
										TextTrimming="CharacterEllipsis" />
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.85"
										AllowSorting="True"
										HeaderText="Percent"
										MappingName="Percent"
										MinimumWidth="110">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel
													Margin="8,0"
													VerticalAlignment="Center"
													Orientation="Horizontal"
													Spacing="6">
													<ProgressBar
														Width="32"
														Height="10"
														VerticalAlignment="Center"
														Maximum="100"
														Minimum="0"
														Value="{Binding Percent}" />
													<TextBlock
														VerticalAlignment="Center"
														Text="{Binding PercentText}"
														TextAlignment="Right" />
												</StackPanel>
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.65"
										AllowSorting="True"
										HeaderText="Size"
										MappingName="Size"
										MinimumWidth="75">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="8,0"
													VerticalAlignment="Center"
													Text="{Binding SizeText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.65"
										AllowSorting="True"
										HeaderText="Allocated"
										MappingName="Allocated"
										MinimumWidth="85">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="8,0"
													VerticalAlignment="Center"
													Text="{Binding AllocatedText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
									<sfgrid:TreeGridTemplateColumn
										treegrid:StarRatio.ColumnRatio="0.5"
										AllowSorting="True"
										HeaderText="Files"
										MappingName="Files"
										MinimumWidth="55">
										<sfgrid:TreeGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock
													Margin="8,0"
													VerticalAlignment="Center"
													Text="{Binding FilesText}"
													TextAlignment="Right" />
											</DataTemplate>
										</sfgrid:TreeGridTemplateColumn.CellTemplate>
									</sfgrid:TreeGridTemplateColumn>
								</sfgrid:SfTreeGrid.Columns>
							</sfgrid:SfTreeGrid>
						</Grid>
					</Grid>

					<!--  Treemap: transparent folder outlines with allocated-size file tiles colored by extension  -->
					<tmap:TreemapView
						x:Name="Treemap"
						Grid.Row="1"
						MinHeight="220"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Background="Transparent"
						Visibility="{x:Bind ViewModel.TreeResultsVisibility, Mode=OneWay}" />

				</Grid>
			</dev:Case>

			<!--  File View: lazy-loaded largest-files table  -->
			<dev:Case Value="FileView">
				<Grid>
					<Grid RowSpacing="8" Visibility="{x:Bind ViewModel.TreeResultsVisibility, Mode=OneWay}">
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!--  File Name | Path | % of Drive | Size | Allocated | Modified | Dup Count | Dup Size | Attributes  -->
						<sfgrid:SfTreeGrid
							x:Name="FileGrid"
							Grid.Row="0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							AllowEditing="False"
							AllowSorting="True"
							AllowTriStateSorting="True"
							AutoGenerateColumns="False"
							CellToolTipOpening="FileGrid_CellToolTipOpening"
							ChildPropertyName="Children"
							ColumnWidthMode="Star"
							DoubleTapped="FileGrid_DoubleTapped"
							GridLinesVisibility="Both"
							HeaderLinesVisibility="Both"
							ItemsSource="{x:Bind ViewModel.FileRows, Mode=OneWay}"
							Loaded="TreeGrid_Loaded"
							NavigationMode="Row"
							RightTapped="FileGrid_RightTapped"
							SelectionMode="Single"
							SizeChanged="TreeGrid_SizeChanged">
							<sfgrid:SfTreeGrid.ColumnSizer>
								<treegrid:TreeGridStarColumnSizer />
							</sfgrid:SfTreeGrid.ColumnSizer>
							<sfgrid:SfTreeGrid.SortComparers>
								<data:SortComparer Comparer="{StaticResource FileNameComparer}" PropertyName="FileName" />
								<data:SortComparer Comparer="{StaticResource DirectoryComparer}" PropertyName="Directory" />
								<data:SortComparer Comparer="{StaticResource PercentOfDriveComparer}" PropertyName="PercentOfDrive" />
								<data:SortComparer Comparer="{StaticResource SizeComparer}" PropertyName="Size" />
								<data:SortComparer Comparer="{StaticResource AllocatedComparer}" PropertyName="Allocated" />
								<data:SortComparer Comparer="{StaticResource ModifiedComparer}" PropertyName="Modified" />
								<data:SortComparer Comparer="{StaticResource DupCountComparer}" PropertyName="DupCount" />
								<data:SortComparer Comparer="{StaticResource DupSizeComparer}" PropertyName="DupSize" />
								<data:SortComparer Comparer="{StaticResource AttributesComparer}" PropertyName="Attributes" />
							</sfgrid:SfTreeGrid.SortComparers>
							<sfgrid:SfTreeGrid.Columns>
								<sfgrid:TreeGridTextColumn
									treegrid:StarRatio.ColumnRatio="1.15"
									HeaderText="File Name"
									MappingName="FileName"
									TextTrimming="CharacterEllipsis" />
								<sfgrid:TreeGridTextColumn
									treegrid:StarRatio.ColumnRatio="2.05"
									HeaderText="Path"
									MappingName="Directory"
									TextTrimming="CharacterEllipsis" />
								<sfgrid:TreeGridTemplateColumn
									treegrid:StarRatio.ColumnRatio="0.75"
									AllowSorting="True"
									HeaderText="% of Drive"
									MappingName="PercentOfDrive">
									<sfgrid:TreeGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<StackPanel
												Margin="12,0"
												VerticalAlignment="Center"
												Orientation="Horizontal"
												Spacing="6">
												<ProgressBar
													Width="36"
													Height="10"
													VerticalAlignment="Center"
													Maximum="100"
													Minimum="0"
													Value="{Binding PercentOfDrive}" />
												<TextBlock
													VerticalAlignment="Center"
													Text="{Binding PercentText}"
													TextAlignment="Right" />
											</StackPanel>
										</DataTemplate>
									</sfgrid:TreeGridTemplateColumn.CellTemplate>
								</sfgrid:TreeGridTemplateColumn>
								<sfgrid:TreeGridTemplateColumn
									treegrid:StarRatio.ColumnRatio="0.80"
									AllowSorting="True"
									HeaderText="Size"
									MappingName="Size">
									<sfgrid:TreeGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												Margin="12,0"
												VerticalAlignment="Center"
												Text="{Binding SizeText}"
												TextAlignment="Right" />
										</DataTemplate>
									</sfgrid:TreeGridTemplateColumn.CellTemplate>
								</sfgrid:TreeGridTemplateColumn>
								<sfgrid:TreeGridTemplateColumn
									treegrid:StarRatio.ColumnRatio="0.80"
									AllowSorting="True"
									HeaderText="Allocated"
									MappingName="Allocated">
									<sfgrid:TreeGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												Margin="12,0"
												VerticalAlignment="Center"
												Text="{Binding AllocatedText}"
												TextAlignment="Right" />
										</DataTemplate>
									</sfgrid:TreeGridTemplateColumn.CellTemplate>
								</sfgrid:TreeGridTemplateColumn>
								<sfgrid:TreeGridTemplateColumn
									treegrid:StarRatio.ColumnRatio="1.20"
									AllowSorting="True"
									HeaderText="Modified"
									MappingName="Modified">
									<sfgrid:TreeGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												Margin="12,0"
												VerticalAlignment="Center"
												Text="{Binding Modified, Converter={StaticResource DateTimeToStringConverter}}"
												TextTrimming="CharacterEllipsis" />
										</DataTemplate>
									</sfgrid:TreeGridTemplateColumn.CellTemplate>
								</sfgrid:TreeGridTemplateColumn>
								<sfgrid:TreeGridTemplateColumn
									treegrid:StarRatio.ColumnRatio="0.65"
									AllowSorting="True"
									HeaderText="Dup Count"
									MappingName="DupCount">
									<sfgrid:TreeGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												Margin="12,0"
												VerticalAlignment="Center"
												Text="{Binding DupCountText}"
												TextAlignment="Right" />
										</DataTemplate>
									</sfgrid:TreeGridTemplateColumn.CellTemplate>
								</sfgrid:TreeGridTemplateColumn>
								<sfgrid:TreeGridTemplateColumn
									treegrid:StarRatio.ColumnRatio="0.75"
									AllowSorting="True"
									HeaderText="Dup Size"
									MappingName="DupSize">
									<sfgrid:TreeGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												Margin="12,0"
												VerticalAlignment="Center"
												Text="{Binding DupSizeText}"
												TextAlignment="Right" />
										</DataTemplate>
									</sfgrid:TreeGridTemplateColumn.CellTemplate>
								</sfgrid:TreeGridTemplateColumn>
								<sfgrid:TreeGridTextColumn
									treegrid:StarRatio.ColumnRatio="0.55"
									HeaderText="Attributes"
									MappingName="Attributes" />
							</sfgrid:SfTreeGrid.Columns>
						</sfgrid:SfTreeGrid>

					</Grid>

				</Grid>
			</dev:Case>
		</dev:SwitchPresenter>

		<!--  Loading animation: one plain "Scanning..." label, centered over the results area.  -->
		<Grid
			Grid.Row="3"
			IsHitTestVisible="False"
			Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
			<StackPanel
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Orientation="Vertical"
				Spacing="12">
				<ProgressRing
					Width="48"
					Height="48"
					IsActive="{x:Bind ViewModel.IsContentBusy, Mode=OneWay}" />
				<TextBlock
					HorizontalAlignment="Center"
					Style="{StaticResource BodyStrongTextBlockStyle}"
					Text="Scanning..." />
			</StackPanel>
		</Grid>
	</Grid>
</Page>
