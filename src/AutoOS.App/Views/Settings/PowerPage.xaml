<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="AutoOS.App.Views.Settings.PowerPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:AutoOS.App.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dev="using:DevWinUI"
	xmlns:ext="using:AutoOS.App.Extensions"
	xmlns:helpers="using:AutoOS.App.Helpers.TreeGrid"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:AutoOS.App.Data.Models.Power"
	xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid"
	xmlns:templateselectors="using:AutoOS.App.Data.TemplateSelectors.Power"
	mc:Ignorable="d">
	<Page.Resources>

		<!--  Enum to Bool Converter  -->
		<converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />

		<!--  AC ComboBox Template  -->
		<DataTemplate x:Key="AcComboBoxEditTemplate" x:DataType="models:Node">
			<ComboBox
				DropDownClosed="EditComboBox_DropDownClosed"
				ItemsSource="{x:Bind Options, Mode=OneTime}"
				Loaded="EditControl_Loaded"
				SelectedItem="{x:Bind State.EditAcOption, Mode=TwoWay}"
				Style="{StaticResource TreeGridComboBoxStyle}"
				ToolTipService.ToolTip="{x:Bind EditAcToolTip, Mode=OneTime}">
				<ComboBox.Resources>
					<SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="Transparent" />
					<SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{ThemeResource ControlFillColorSecondary}" />
					<Thickness x:Key="ComboBoxBackgroundBorderThicknessFocused">0</Thickness>
				</ComboBox.Resources>
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="models:Option">
						<TextBlock
							Padding="0,2,0,0"
							FontFamily="Segoe UI Variable Static Text"
							Text="{x:Bind FriendlyName, Mode=OneTime}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="NoWrap"
							ToolTipService.ToolTip="{x:Bind Description, Mode=OneTime}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</DataTemplate>

		<!--  AC TextBox Template  -->
		<DataTemplate x:Key="AcTextBoxEditTemplate" x:DataType="models:Node">
			<TextBox
				Loaded="EditControl_Loaded"
				Style="{StaticResource TreeGridTextBoxStyle}"
				Text="{x:Bind State.EditAcValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				ToolTipService.ToolTip="{x:Bind EditAcToolTip, Mode=OneTime}">
				<TextBox.Resources>
					<SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
					<SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource ControlFillColorSecondary}" />
					<Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
				</TextBox.Resources>
			</TextBox>
		</DataTemplate>

		<!--  DC ComboBox Template  -->
		<DataTemplate x:Key="DcComboBoxEditTemplate" x:DataType="models:Node">
			<ComboBox
				DropDownClosed="EditComboBox_DropDownClosed"
				ItemsSource="{x:Bind Options, Mode=OneTime}"
				Loaded="EditControl_Loaded"
				SelectedItem="{x:Bind State.EditDcOption, Mode=TwoWay}"
				Style="{StaticResource TreeGridComboBoxStyle}"
				ToolTipService.ToolTip="{x:Bind EditDcToolTip, Mode=OneTime}">
				<ComboBox.Resources>
					<SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="Transparent" />
					<SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{ThemeResource ControlFillColorSecondary}" />
					<Thickness x:Key="ComboBoxBackgroundBorderThicknessFocused">0</Thickness>
				</ComboBox.Resources>
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="models:Option">
						<TextBlock
							Padding="0,2,0,0"
							FontFamily="Segoe UI Variable Static Text"
							Text="{x:Bind FriendlyName, Mode=OneTime}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="NoWrap"
							ToolTipService.ToolTip="{x:Bind Description, Mode=OneTime}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</DataTemplate>

		<!--  DC TextBox Template  -->
		<DataTemplate x:Key="DcTextBoxEditTemplate" x:DataType="models:Node">
			<TextBox
				Loaded="EditControl_Loaded"
				Style="{StaticResource TreeGridTextBoxStyle}"
				Text="{x:Bind State.EditDcValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				ToolTipService.ToolTip="{x:Bind EditDcToolTip, Mode=OneTime}">
				<TextBox.Resources>
					<SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
					<SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource ControlFillColorSecondary}" />
					<Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
				</TextBox.Resources>
			</TextBox>
		</DataTemplate>

		<!--  Cell Style Selector  -->
		<templateselectors:CellStyleSelector
			x:Key="CellStyleSelector"
			CriticalStyle="{StaticResource CriticalCellStyle}"
			SuccessStyle="{StaticResource SuccessCellStyle}" />

		<!--  Edit Template Selectors  -->
		<templateselectors:EditTemplateSelector
			x:Key="AcEditTemplateSelector"
			ComboBoxTemplate="{StaticResource AcComboBoxEditTemplate}"
			TextBoxTemplate="{StaticResource AcTextBoxEditTemplate}" />
		<templateselectors:EditTemplateSelector
			x:Key="DcEditTemplateSelector"
			ComboBoxTemplate="{StaticResource DcComboBoxEditTemplate}"
			TextBoxTemplate="{StaticResource DcTextBoxEditTemplate}" />

		<!--  Power Plan  -->
		<DataTemplate x:Key="PowerPlanTemplate" x:DataType="models:Plan">
			<TextBlock
				Text="{x:Bind Name, Mode=OneTime}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap"
				ToolTipService.ToolTip="{x:Bind Description, Mode=OneTime}" />
		</DataTemplate>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<StackPanel Grid.Row="0" Margin="36,24,36,0">
			<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Energy &amp; Power" />

			<Grid Margin="0,48,0,8" ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!--  Search  -->
				<dev:TextBox
					x:Name="Search"
					Grid.Column="0"
					IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
					IsSpellCheckEnabled="False"
					PlaceholderText="Search..."
					TextChanged="Search_TextChanged"
					ToolTipService.ToolTip="Search (Ctrl+F)">
					<dev:TextBox.KeyboardAccelerators>
						<KeyboardAccelerator
							Key="F"
							Invoked="Search_AcceleratorInvoked"
							Modifiers="Control" />
					</dev:TextBox.KeyboardAccelerators>
					<dev:TextBox.Content>
						<Button Content="&#xE71E;" />
					</dev:TextBox.Content>
				</dev:TextBox>

				<!--  Filter  -->
				<DropDownButton
					Grid.Column="1"
					VerticalAlignment="Stretch"
					IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
					ToolTipService.ToolTip="Filter (Alt+Shift+F)">
					<DropDownButton.Content>
						<FontIcon FontSize="12" Glyph="&#xE71C;" />
					</DropDownButton.Content>
					<DropDownButton.Flyout>
						<MenuFlyout Placement="Bottom">
							<ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterSetting, Mode=TwoWay}" Text="Setting" />
							<ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterDescription, Mode=TwoWay}" Text="Description" />
							<ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterAc, Mode=TwoWay}" Text="AC" />
							<ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterDc, Mode=TwoWay}" Text="DC" />
							<ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterGuid, Mode=TwoWay}" Text="GUID" />
							<MenuFlyoutSeparator />
							<RadioMenuFlyoutItem
								Click="FilterMode_Contains_Click"
								GroupName="PowerFilterMode"
								IsChecked="{x:Bind ViewModel.FilterMode, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Contains}"
								Text="Contains" />
							<RadioMenuFlyoutItem
								Click="FilterMode_ExactMatch_Click"
								GroupName="PowerFilterMode"
								IsChecked="{x:Bind ViewModel.FilterMode, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ExactMatch}"
								Text="Exact Match" />
						</MenuFlyout>
					</DropDownButton.Flyout>
					<DropDownButton.KeyboardAccelerators>
						<KeyboardAccelerator Key="F" Modifiers="Menu, Shift" />
					</DropDownButton.KeyboardAccelerators>
				</DropDownButton>
			</Grid>

			<Border
				Margin="0,0,0,8"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{ThemeResource OverlayCornerRadius}">

				<!--  Command Bar  -->
				<CommandBar
					ext:CommandBarExtensions.ApplyOverflowIndent="True"
					ext:CommandBarExtensions.CommandAlignment="Left"
					ext:CommandBarExtensions.OverflowButtonAlignment="Right"
					DefaultLabelPosition="Right">

					<!--  Undo  -->
					<AppBarButton
						Command="{x:Bind ViewModel.UndoCommand}"
						Icon="{dev:FontIcon Glyph=&#xE7A7;}"
						Label="Undo"
						ToolTipService.ToolTip="Undo (Ctrl+Z)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="Z" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>

					<!--  Redo  -->
					<AppBarButton
						Command="{x:Bind ViewModel.RedoCommand}"
						Icon="{dev:FontIcon Glyph=&#xE7A6;}"
						Label="Redo"
						ToolTipService.ToolTip="Redo (Ctrl+Y)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="Y" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>

					<AppBarSeparator Margin="4,0" />

					<!--  Active CombobBox  -->
					<AppBarElementContainer VerticalContentAlignment="Center">
						<ComboBox
							x:Name="ActivePowerPlanComboBox"
							Width="220"
							IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
							ItemTemplate="{StaticResource PowerPlanTemplate}"
							ItemsSource="{x:Bind ViewModel.Plans, Mode=OneWay}"
							SelectedItem="{x:Bind ViewModel.ActivePlan, Mode=TwoWay}">
							<ComboBox.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutItem Command="{x:Bind ViewModel.EditCommand}" Text="Edit">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE70F;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{x:Bind ViewModel.DuplicateCommand}" Text="Duplicate">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xECCD;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{x:Bind ViewModel.ExportCommand}" Text="Export">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xEDE1;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{x:Bind ViewModel.DeleteCommand}" Text="Delete">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE74D;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
								</MenuFlyout>
							</ComboBox.ContextFlyout>
						</ComboBox>
					</AppBarElementContainer>

					<!--  Compare ComboBox  -->
					<AppBarElementContainer VerticalContentAlignment="Center">
						<ComboBox
							x:Name="ComparePowerPlanComboBox"
							Width="220"
							Margin="4,0,0,0"
							IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
							ItemTemplate="{StaticResource PowerPlanTemplate}"
							ItemsSource="{x:Bind ViewModel.ComparePlans, Mode=OneWay}"
							SelectedItem="{x:Bind ViewModel.ComparePlan, Mode=TwoWay}" />
					</AppBarElementContainer>

					<AppBarSeparator Margin="4,0" />

					<!--  Import  -->
					<AppBarButton
						Command="{x:Bind ViewModel.ImportCommand}"
						Icon="{dev:FontIcon Glyph=&#xE8B5;}"
						Label="Import"
						ToolTipService.ToolTip="Import (Ctrl+I)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="I" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>

					<!--  Restore  -->
					<AppBarButton
						Command="{x:Bind ViewModel.RestoreCommand}"
						Icon="{dev:FontIcon Glyph=&#xE777;}"
						Label="Restore"
						ToolTipService.ToolTip="Restore (Ctrl+R)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="R" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>

					<AppBarSeparator Margin="4,0" />

					<!--  View Changes  -->
					<AppBarToggleButton
						x:Name="ViewChanges"
						Command="{x:Bind ViewModel.ToggleViewChangesCommand}"
						Icon="{dev:FontIcon Glyph=&#xF28B;}"
						IsChecked="{x:Bind ViewModel.ViewChanges, Mode=TwoWay}"
						Label="{x:Bind ViewModel.ViewChangesLabel, Mode=OneWay}"
						ToolTipService.ToolTip="View Changes (Ctrl+D)">
						<AppBarToggleButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="D" Modifiers="Control" />
						</AppBarToggleButton.KeyboardAccelerators>
					</AppBarToggleButton>

					<!--  Save Changes  -->
					<AppBarButton
						Command="{x:Bind ViewModel.SaveChangesCommand}"
						Icon="{dev:FontIcon Glyph=&#xE74E;}"
						Label="Save Changes"
						ToolTipService.ToolTip="Save Changes (Ctrl+S)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="S" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>
				</CommandBar>
			</Border>
		</StackPanel>

		<dev:SwitchPresenter Grid.Row="1" Value="{x:Bind ViewModel.SwitchPresenterValue, Mode=OneWay}">

			<!--  Loading  -->
			<dev:Case Value="Loading">
				<StackPanel
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Spacing="8">
					<ProgressRing IsActive="True" />
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="Loading power plans..." />
				</StackPanel>
			</dev:Case>

			<!--  Loaded  -->
			<dev:Case Value="Loaded">
				<Grid Margin="36,0,36,36">

					<!--  Active  -->
					<sfgrid:SfTreeGrid
						x:Name="TreeGrid"
						helpers:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
						AllowEditing="True"
						AllowSorting="True"
						AllowTriStateSorting="True"
						AutoExpandMode="AllNodesExpanded"
						AutoGenerateColumns="False"
						CellToolTipOpening="TreeGrid_CellToolTipOpening"
						ChildPropertyName="Children"
						ColumnWidthMode="Star"
						CurrentCellBeginEdit="TreeGrid_CurrentCellBeginEdit"
						CurrentCellEndEdit="TreeGrid_CurrentCellEndEdit"
						DataValidationMode="InView"
						EditTrigger="OnTap"
						ExpandStateMappingName="IsExpanded"
						FilterLevel="All"
						GridLinesVisibility="Both"
						HeaderLinesVisibility="Both"
						ItemsSource="{x:Bind ViewModel.TreeNodes}"
						NavigationMode="Cell"
						PasteOption="None"
						SelectionMode="Single"
						ShowToolTip="True"
						SizeChanged="TreeGrid_SizeChanged"
						TreeGridContextFlyoutOpening="TreeGrid_TreeGridContextFlyoutOpening"
						Visibility="{x:Bind ViewModel.NormalVisibility, Mode=OneWay}">
						<sfgrid:SfTreeGrid.HeaderContextFlyout>
							<MenuFlyout />
						</sfgrid:SfTreeGrid.HeaderContextFlyout>

						<sfgrid:SfTreeGrid.ColumnSizer>
							<helpers:TreeGridStarColumnSizer />
						</sfgrid:SfTreeGrid.ColumnSizer>

						<sfgrid:SfTreeGrid.Columns>

							<!--  Setting  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="2"
								AllowEditing="False"
								AllowFocus="False"
								HeaderText="Setting"
								MappingName="DisplayName"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />

							<!--  Plugged in (AC)  -->
							<sfgrid:TreeGridTemplateColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="True"
								AllowSorting="True"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								EditTemplateSelector="{StaticResource AcEditTemplateSelector}"
								HeaderText="Plugged in (AC)"
								MappingName="DisplayAc"
								ShowToolTip="True">
								<sfgrid:TreeGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="models:Node">
										<TextBlock
											Margin="12,0"
											VerticalAlignment="Center"
											Text="{x:Bind State.DisplayAc, Mode=OneWay, FallbackValue=''}"
											TextTrimming="CharacterEllipsis"
											TextWrapping="NoWrap" />
									</DataTemplate>
								</sfgrid:TreeGridTemplateColumn.CellTemplate>
							</sfgrid:TreeGridTemplateColumn>

							<!--  On battery (DC)  -->
							<sfgrid:TreeGridTemplateColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="True"
								AllowSorting="True"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								EditTemplateSelector="{StaticResource DcEditTemplateSelector}"
								HeaderText="On battery (DC)"
								MappingName="DisplayDc"
								ShowToolTip="True">
								<sfgrid:TreeGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="models:Node">
										<TextBlock
											Margin="12,0"
											VerticalAlignment="Center"
											Text="{x:Bind State.DisplayDc, Mode=OneWay, FallbackValue=''}"
											TextTrimming="CharacterEllipsis"
											TextWrapping="NoWrap" />
									</DataTemplate>
								</sfgrid:TreeGridTemplateColumn.CellTemplate>
							</sfgrid:TreeGridTemplateColumn>
						</sfgrid:SfTreeGrid.Columns>
					</sfgrid:SfTreeGrid>

					<!--  Compare  -->
					<sfgrid:SfTreeGrid
						x:Name="CompareTreeGrid"
						helpers:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
						AllowEditing="True"
						AllowSorting="True"
						AllowTriStateSorting="True"
						AutoExpandMode="AllNodesExpanded"
						AutoGenerateColumns="False"
						CellToolTipOpening="TreeGrid_CellToolTipOpening"
						ChildPropertyName="Children"
						ColumnWidthMode="Star"
						CurrentCellBeginEdit="TreeGrid_CurrentCellBeginEdit"
						CurrentCellEndEdit="TreeGrid_CurrentCellEndEdit"
						DataValidationMode="InView"
						EditTrigger="OnTap"
						ExpandStateMappingName="IsExpanded"
						FilterLevel="All"
						GridLinesVisibility="Both"
						HeaderLinesVisibility="Both"
						ItemsSource="{x:Bind ViewModel.CompareNodes}"
						NavigationMode="Cell"
						PasteOption="None"
						SelectionMode="Single"
						ShowToolTip="True"
						SizeChanged="TreeGrid_SizeChanged"
						TreeGridContextFlyoutOpening="TreeGrid_TreeGridContextFlyoutOpening"
						Visibility="{x:Bind ViewModel.ComparisonVisibility, Mode=OneWay}">
						<sfgrid:SfTreeGrid.HeaderContextFlyout>
							<MenuFlyout />
						</sfgrid:SfTreeGrid.HeaderContextFlyout>

						<sfgrid:SfTreeGrid.ColumnSizer>
							<helpers:TreeGridStarColumnSizer />
						</sfgrid:SfTreeGrid.ColumnSizer>

						<sfgrid:SfTreeGrid.Columns>

							<!--  Setting  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="2"
								AllowEditing="False"
								AllowFocus="False"
								HeaderText="Setting"
								MappingName="DisplayName"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />

							<!--  Power Plan 1 (AC)  -->
							<sfgrid:TreeGridTemplateColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="True"
								AllowSorting="True"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								EditTemplateSelector="{StaticResource AcEditTemplateSelector}"
								HeaderText="{x:Bind ViewModel.ActivePlanAcHeader, Mode=OneWay}"
								MappingName="DisplayAc"
								ShowToolTip="True">
								<sfgrid:TreeGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="models:Node">
										<TextBlock
											Margin="12,0"
											VerticalAlignment="Center"
											Text="{x:Bind State.DisplayAc, Mode=OneWay, FallbackValue=''}"
											TextTrimming="CharacterEllipsis"
											TextWrapping="NoWrap" />
									</DataTemplate>
								</sfgrid:TreeGridTemplateColumn.CellTemplate>
							</sfgrid:TreeGridTemplateColumn>

							<!--  Power Plan 1 (DC)  -->
							<sfgrid:TreeGridTemplateColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="True"
								AllowSorting="True"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								EditTemplateSelector="{StaticResource DcEditTemplateSelector}"
								HeaderText="{x:Bind ViewModel.ActivePlanDcHeader, Mode=OneWay}"
								MappingName="DisplayDc"
								ShowToolTip="True">
								<sfgrid:TreeGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="models:Node">
										<TextBlock
											Margin="12,0"
											VerticalAlignment="Center"
											Text="{x:Bind State.DisplayDc, Mode=OneWay, FallbackValue=''}"
											TextTrimming="CharacterEllipsis"
											TextWrapping="NoWrap" />
									</DataTemplate>
								</sfgrid:TreeGridTemplateColumn.CellTemplate>
							</sfgrid:TreeGridTemplateColumn>

							<!--  Power Plan 2 (AC)  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="False"
								AllowFocus="False"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								HeaderText="{x:Bind ViewModel.ComparePlanAcHeader, Mode=OneWay}"
								MappingName="DisplayCompareAc"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />

							<!--  Power Plan 2 (DC)  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="False"
								AllowFocus="False"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								HeaderText="{x:Bind ViewModel.ComparePlanDcHeader, Mode=OneWay}"
								MappingName="DisplayCompareDc"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />
						</sfgrid:SfTreeGrid.Columns>

					</sfgrid:SfTreeGrid>

					<!--  View Changes  -->
					<sfgrid:SfTreeGrid
						x:Name="ChangesTreeGrid"
						helpers:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
						AllowEditing="True"
						AllowSorting="True"
						AllowTriStateSorting="True"
						AutoExpandMode="AllNodesExpanded"
						AutoGenerateColumns="False"
						CellToolTipOpening="TreeGrid_CellToolTipOpening"
						ChildPropertyName="Children"
						ColumnWidthMode="Star"
						CurrentCellBeginEdit="TreeGrid_CurrentCellBeginEdit"
						CurrentCellEndEdit="TreeGrid_CurrentCellEndEdit"
						DataValidationMode="InView"
						EditTrigger="OnTap"
						ExpandStateMappingName="IsExpanded"
						FilterLevel="All"
						GridLinesVisibility="Both"
						HeaderLinesVisibility="Both"
						ItemsSource="{x:Bind ViewModel.ChangeNodes}"
						NavigationMode="Cell"
						PasteOption="None"
						SelectionMode="Single"
						ShowToolTip="True"
						SizeChanged="TreeGrid_SizeChanged"
						TreeGridContextFlyoutOpening="TreeGrid_TreeGridContextFlyoutOpening"
						Visibility="{x:Bind ViewModel.ViewChangesVisibility, Mode=OneWay}">
						<sfgrid:SfTreeGrid.HeaderContextFlyout>
							<MenuFlyout />
						</sfgrid:SfTreeGrid.HeaderContextFlyout>

						<sfgrid:SfTreeGrid.ColumnSizer>
							<helpers:TreeGridStarColumnSizer />
						</sfgrid:SfTreeGrid.ColumnSizer>

						<sfgrid:SfTreeGrid.Columns>

							<!--  Setting  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="2"
								AllowEditing="False"
								AllowFocus="False"
								HeaderText="Setting"
								MappingName="DisplayName"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />

							<!--  Original (AC)  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="False"
								AllowFocus="False"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								HeaderText="Original (AC)"
								MappingName="DisplayOriginalAc"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />

							<!--  Original (DC)  -->
							<sfgrid:TreeGridTextColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="False"
								AllowFocus="False"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								HeaderText="Original (DC)"
								MappingName="DisplayOriginalDc"
								ShowToolTip="True"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />

							<!--  New (AC)  -->
							<sfgrid:TreeGridTemplateColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="True"
								AllowSorting="True"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								EditTemplateSelector="{StaticResource AcEditTemplateSelector}"
								HeaderText="New (AC)"
								MappingName="DisplayAc"
								ShowToolTip="True">
								<sfgrid:TreeGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="models:Node">
										<TextBlock
											Margin="12,0"
											VerticalAlignment="Center"
											Text="{x:Bind State.DisplayAc, Mode=OneWay, FallbackValue=''}"
											TextTrimming="CharacterEllipsis"
											TextWrapping="NoWrap" />
									</DataTemplate>
								</sfgrid:TreeGridTemplateColumn.CellTemplate>
							</sfgrid:TreeGridTemplateColumn>

							<!--  New (DC)  -->
							<sfgrid:TreeGridTemplateColumn
								helpers:StarRatio.ColumnRatio="1"
								AllowEditing="True"
								AllowSorting="True"
								CellStyleSelector="{StaticResource CellStyleSelector}"
								EditTemplateSelector="{StaticResource DcEditTemplateSelector}"
								HeaderText="New (DC)"
								MappingName="DisplayDc"
								ShowToolTip="True">
								<sfgrid:TreeGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="models:Node">
										<TextBlock
											Margin="12,0"
											VerticalAlignment="Center"
											Text="{x:Bind State.DisplayDc, Mode=OneWay, FallbackValue=''}"
											TextTrimming="CharacterEllipsis"
											TextWrapping="NoWrap" />
									</DataTemplate>
								</sfgrid:TreeGridTemplateColumn.CellTemplate>
							</sfgrid:TreeGridTemplateColumn>
						</sfgrid:SfTreeGrid.Columns>
					</sfgrid:SfTreeGrid>
				</Grid>
			</dev:Case>
		</dev:SwitchPresenter>
	</Grid>
</Page>
