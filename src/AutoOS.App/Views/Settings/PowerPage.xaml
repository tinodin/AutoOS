<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AutoOS.Views.Settings.PowerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:AutoOS.Common"
      xmlns:converters="using:CommunityToolkit.WinUI.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:grid="using:Syncfusion.UI.Xaml.Grids"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid"
      xmlns:viewModels="using:AutoOS.ViewModels"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!--  Critical  -->
        <Style x:Key="CriticalCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>

        <!--  Success  -->
        <Style x:Key="SuccessCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>

        <!--  Caution  -->
        <Style x:Key="CautionCellStyle"
               TargetType="sfgrid:TreeGridCell">
            <Setter Property="Background"
                    Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        </Style>

        <!--  Cell Style Selector  -->
        <viewModels:PowerCellStyleSelector x:Key="PowerCellStyleSelector"
                                           CautionStyle="{StaticResource CautionCellStyle}"
                                           CriticalStyle="{StaticResource CriticalCellStyle}"
                                           SuccessStyle="{StaticResource SuccessCellStyle}" />

        <!--  AC ComboBox  -->
        <DataTemplate x:Key="AcComboBoxEditTemplate"
                      x:DataType="viewModels:PowerTreeNode">
            <ComboBox HorizontalAlignment="Stretch"
                      BorderThickness="0"
                      CornerRadius="0"
                      ItemsSource="{x:Bind Options, Mode=OneWay}"
                      KeyDown="EditControl_KeyDown"
                      Loaded="EditControl_Loaded"
                      SelectedItem="{x:Bind EditAcOption, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind EditAcToolTip, Mode=OneWay}"
                      UseSystemFocusVisuals="False">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"
                                     Color="{ThemeResource ControlFillColorSecondary}" />
                    <Thickness x:Key="ComboBoxBackgroundBorderThicknessFocused">0</Thickness>
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerSettingOption">
                        <TextBlock Padding="0,2,0,0"
                                   FontFamily="Segoe UI Variable Static Text"
                                   Text="{x:Bind FriendlyName, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <!--  AC TextBox  -->
        <DataTemplate x:Key="AcTextBoxEditTemplate"
                      x:DataType="viewModels:PowerTreeNode">
            <TextBox Padding="12,5,6,6"
                     BorderThickness="0"
                     CornerRadius="0"
                     FontFamily="Segoe UI Variable Static Text"
                     KeyDown="EditControl_KeyDown"
                     Loaded="EditControl_Loaded"
                     Text="{x:Bind EditAcValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTipService.ToolTip="{x:Bind EditAcToolTip, Mode=OneWay}">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                     Color="{ThemeResource ControlFillColorSecondary}" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
        </DataTemplate>

        <!--  DC ComboBox  -->
        <DataTemplate x:Key="DcComboBoxEditTemplate"
                      x:DataType="viewModels:PowerTreeNode">
            <ComboBox HorizontalAlignment="Stretch"
                      BorderThickness="0"
                      CornerRadius="0"
                      ItemsSource="{x:Bind Options, Mode=OneWay}"
                      KeyDown="EditControl_KeyDown"
                      Loaded="EditControl_Loaded"
                      SelectedItem="{x:Bind EditDcOption, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind EditDcToolTip, Mode=OneWay}"
                      UseSystemFocusVisuals="False">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="ComboBoxBackgroundFocused"
                                     Color="{ThemeResource ControlFillColorSecondary}" />
                    <Thickness x:Key="ComboBoxBackgroundBorderThicknessFocused">0</Thickness>
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PowerSettingOption">
                        <TextBlock Padding="0,2,0,0"
                                   FontFamily="Segoe UI Variable Static Text"
                                   Text="{x:Bind FriendlyName, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>

        <!--  DC TextBox  -->
        <DataTemplate x:Key="DcTextBoxEditTemplate"
                      x:DataType="viewModels:PowerTreeNode">
            <TextBox Padding="12,5,6,6"
                     BorderThickness="0"
                     CornerRadius="0"
                     FontFamily="Segoe UI Variable Static Text"
                     KeyDown="EditControl_KeyDown"
                     Loaded="EditControl_Loaded"
                     Text="{x:Bind EditDcValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTipService.ToolTip="{x:Bind EditDcToolTip, Mode=OneWay}">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                     Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                                     Color="{ThemeResource ControlFillColorSecondary}" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
        </DataTemplate>

        <viewModels:PowerEditTemplateSelector x:Key="AcEditTemplateSelector"
                                              ComboBoxTemplate="{StaticResource AcComboBoxEditTemplate}"
                                              TextBoxTemplate="{StaticResource AcTextBoxEditTemplate}" />
        <viewModels:PowerEditTemplateSelector x:Key="DcEditTemplateSelector"
                                              ComboBoxTemplate="{StaticResource DcComboBoxEditTemplate}"
                                              TextBoxTemplate="{StaticResource DcTextBoxEditTemplate}" />

        <!--  Power Plan  -->
        <DataTemplate x:Key="PowerPlanTemplate"
                      x:DataType="viewModels:PowerPlan">
            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0"
                    Margin="36,24,36,0">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                       Text="Energy &amp; Power" />

            <Grid Margin="0,48,0,8"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Search  -->
                <dev:TextBox x:Name="Search"
                             Grid.Column="0"
                             IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                             IsSpellCheckEnabled="False"
                             PlaceholderText="Search..."
                             TextChanged="Search_TextChanged"
                             ToolTipService.ToolTip="Search (Ctrl+F)">
                    <dev:TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F"
                                             Invoked="Search_AcceleratorInvoked"
                                             Modifiers="Control" />
                    </dev:TextBox.KeyboardAccelerators>
                    <dev:TextBox.Content>
                        <Button Content="&#xE71E;" />
                    </dev:TextBox.Content>
                </dev:TextBox>

                <!--  Filter  -->
                <DropDownButton Grid.Column="1"
                                VerticalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                                ToolTipService.ToolTip="Filter (Alt+Shift+F)">
                    <DropDownButton.Content>
                        <FontIcon FontSize="12"
                                  Glyph="&#xE71C;" />
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterSetting, Mode=TwoWay}"
                                                  Text="Setting" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterDescription, Mode=TwoWay}"
                                                  Text="Description" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterAc, Mode=TwoWay}"
                                                  Text="AC" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterDc, Mode=TwoWay}"
                                                  Text="DC" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.FilterGuid, Mode=TwoWay}"
                                                  Text="GUID" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem GroupName="PowerFilterMode"
                                                 IsChecked="{x:Bind ViewModel.FilterContains, Mode=TwoWay}"
                                                 Text="Contains" />
                            <RadioMenuFlyoutItem GroupName="PowerFilterMode"
                                                 IsChecked="{x:Bind ViewModel.FilterExactMatch, Mode=TwoWay}"
                                                 Text="Exact Match" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                    <DropDownButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F"
                                             Modifiers="Menu, Shift" />
                    </DropDownButton.KeyboardAccelerators>
                </DropDownButton>
            </Grid>

            <!--  Command Bar  -->
            <Border Margin="0,0,0,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <CommandBar>

                    <!--  Undo  -->
                    <AppBarButton Click="Undo_Click"
                                  Icon="{dev:FontIcon Glyph=&#xE7A7;}"
                                  IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                                  Label="Undo"
                                  ToolTipService.ToolTip="Undo (Ctrl+Z)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z"
                                                 Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>

                    <!--  Redo  -->
                    <AppBarButton Click="Redo_Click"
                                  Icon="{dev:FontIcon Glyph=&#xE7A6;}"
                                  IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                                  Label="Redo"
                                  ToolTipService.ToolTip="Redo (Ctrl+Y)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Y"
                                                 Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>

                    <AppBarSeparator Margin="4,0" />

                    <!--  Active Power Plan  -->
                    <AppBarElementContainer Style="{StaticResource CommandBarElementContainerStyle}">
                        <ComboBox x:Name="PowerPlanComboBox"
                                  Width="220"
                                  ItemTemplate="{StaticResource PowerPlanTemplate}"
                                  ItemsSource="{x:Bind ViewModel.PowerPlans, Mode=OneWay}"
                                  SelectionChanged="PowerPlanComboBox_SelectionChanged"
                                  ToolTipService.ToolTip="Active Power Plan">
                            <ComboBox.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="Edit_Click"
                                                    Text="Edit">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="Duplicate_Click"
                                                    Text="Duplicate">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xECCD;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="Export_Click"
                                                    Text="Export">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEDE1;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="Delete_Click"
                                                    Text="Delete">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ComboBox.ContextFlyout>
                        </ComboBox>
                    </AppBarElementContainer>

                    <!--  Compare Power Plan  -->
                    <AppBarElementContainer Style="{StaticResource CommandBarElementContainerStyle}">
                        <ComboBox x:Name="ComparePowerPlanComboBox"
                                  Width="220"
                                  Margin="2,0,0,0"
                                  IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                                  ItemTemplate="{StaticResource PowerPlanTemplate}"
                                  ItemsSource="{x:Bind ViewModel.ComparePlans, Mode=OneWay}"
                                  SelectionChanged="ComparePowerPlanComboBox_SelectionChanged"
                                  ToolTipService.ToolTip="Compare Power Plan" />
                    </AppBarElementContainer>

                    <AppBarSeparator Margin="4,0" />

                    <!--  Restore  -->
                    <AppBarButton Click="Restore_Click"
                                  Icon="{dev:FontIcon Glyph=&#xE777;}"
                                  IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                                  Label="Restore"
                                  ToolTipService.ToolTip="Restore (Ctrl+R)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R"
                                                 Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>

                    <!--  Import  -->
                    <AppBarButton Click="Import_Click"
                                  Icon="{dev:FontIcon Glyph=&#xE8B5;}"
                                  IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                                  Label="Import"
                                  ToolTipService.ToolTip="Import (Ctrl+I)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="I"
                                                 Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>

                    <AppBarSeparator Margin="4,0" />

                    <!--  View Changes  -->
                    <AppBarToggleButton x:Name="ViewChanges"
                                        Checked="ViewChanges_Checked"
                                        Icon="{dev:FontIcon Glyph=&#xF28B;}"
                                        IsEnabled="{x:Bind ViewModel.IsLoaded, Mode=OneWay}"
                                        Label="{x:Bind ViewModel.ViewChangesLabel, Mode=OneWay}"
                                        ToolTipService.ToolTip="View Changes (Ctrl+D)"
                                        Unchecked="ViewChanges_Unchecked">
                        <AppBarToggleButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="D"
                                                 Modifiers="Control" />
                        </AppBarToggleButton.KeyboardAccelerators>
                    </AppBarToggleButton>

                    <!--  Save Changes  -->
                    <AppBarButton Click="SaveChanges_Click"
                                  Icon="{dev:FontIcon Glyph=&#xE74E;}"
                                  IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                  Label="Save Changes"
                                  ToolTipService.ToolTip="Save Changes (Ctrl+S)">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S"
                                                 Modifiers="Control" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="36,0,36,36">
            <!--  Active Power Plan  -->
            <sfgrid:SfTreeGrid x:Name="PowerTreeGrid"
                               common:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
                               AllowEditing="True"
                               AllowSorting="True"
                               AllowTriStateSorting="True"
                               AutoExpandMode="AllNodesExpanded"
                               AutoGenerateColumns="False"
                               CellToolTipOpening="PowerTreeGrid_CellToolTipOpening"
                               ChildPropertyName="Children"
                               ColumnWidthMode="Star"
                               CurrentCellBeginEdit="PowerTreeGrid_CurrentCellBeginEdit"
                               CurrentCellEndEdit="PowerTreeGrid_CurrentCellEndEdit"
                               DataValidationMode="InView"
                               EditTrigger="OnTap"
                               EditorSelectionBehavior="SelectAll"
                               FilterLevel="All"
                               GridLinesVisibility="Both"
                               HeaderLinesVisibility="Both"
                               ItemsSource="{x:Bind ViewModel.TreeNodes}"
                               Loaded="PowerTreeGrid_Loaded"
                               NavigationMode="Cell"
                               PasteOption="None"
                               SelectionMode="Single"
                               ShowToolTip="True"
                               SizeChanged="PowerTreeGrid_SizeChanged"
                               TreeGridContextFlyoutOpening="PowerTreeGrid_TreeGridContextFlyoutOpening"
                               Visibility="{x:Bind ViewModel.NormalVisibility, Mode=OneWay}">
                <sfgrid:SfTreeGrid.HeaderContextFlyout>
                    <MenuFlyout />
                </sfgrid:SfTreeGrid.HeaderContextFlyout>
                <sfgrid:SfTreeGrid.RecordContextFlyout>
                    <MenuFlyout />
                </sfgrid:SfTreeGrid.RecordContextFlyout>
                <sfgrid:SfTreeGrid.ExpanderContextFlyout>
                    <MenuFlyout />
                </sfgrid:SfTreeGrid.ExpanderContextFlyout>
                <sfgrid:SfTreeGrid.ColumnSizer>
                    <common:TreeGridStarColumnSizer />
                </sfgrid:SfTreeGrid.ColumnSizer>
                <sfgrid:SfTreeGrid.Columns>
                    <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                               AllowEditing="False"
                                               HeaderText="Setting"
                                               MappingName="DisplayName"
                                               ShowToolTip="True"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                    <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="1"
                                                   AllowEditing="True"
                                                   AllowSorting="True"
                                                   CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                   EditTemplateSelector="{StaticResource AcEditTemplateSelector}"
                                                   HeaderText="Plugged in (AC)"
                                                   MappingName="DisplayAc"
                                                   ShowToolTip="True">
                        <sfgrid:TreeGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="viewModels:PowerTreeNode">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind DisplayAc, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </sfgrid:TreeGridTemplateColumn.CellTemplate>
                    </sfgrid:TreeGridTemplateColumn>
                    <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="1"
                                                   AllowEditing="True"
                                                   AllowSorting="True"
                                                   CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                   EditTemplateSelector="{StaticResource DcEditTemplateSelector}"
                                                   HeaderText="On battery (DC)"
                                                   MappingName="DisplayDc"
                                                   ShowToolTip="True">
                        <sfgrid:TreeGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="viewModels:PowerTreeNode">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind DisplayDc, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </sfgrid:TreeGridTemplateColumn.CellTemplate>
                    </sfgrid:TreeGridTemplateColumn>
                </sfgrid:SfTreeGrid.Columns>
            </sfgrid:SfTreeGrid>

            <!--  Compare Power Plans  -->
            <dev:SwitchPresenter Visibility="{x:Bind ViewModel.ComparisonVisibility, Mode=OneWay}"
                                 Value="{x:Bind ViewModel.ComparisonState, Mode=OneWay}">
                <dev:Case Value="Content">
                    <sfgrid:SfTreeGrid x:Name="ComparePowerTreeGrid"
                                       common:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
                                       AllowEditing="True"
                                       AllowSorting="True"
                                       AllowTriStateSorting="True"
                                       AutoExpandMode="AllNodesExpanded"
                                       AutoGenerateColumns="False"
                                       CellToolTipOpening="PowerTreeGrid_CellToolTipOpening"
                                       ChildPropertyName="Children"
                                       ColumnWidthMode="Star"
                                       CurrentCellBeginEdit="PowerTreeGrid_CurrentCellBeginEdit"
                                       CurrentCellEndEdit="PowerTreeGrid_CurrentCellEndEdit"
                                       DataValidationMode="InView"
                                       EditTrigger="OnTap"
                                       EditorSelectionBehavior="SelectAll"
                                       FilterLevel="All"
                                       GridLinesVisibility="Both"
                                       HeaderLinesVisibility="Both"
                                       ItemsSource="{x:Bind ViewModel.CompareNodes}"
                                       Loaded="PowerTreeGrid_Loaded"
                                       NavigationMode="Cell"
                                       PasteOption="None"
                                       SelectionMode="Single"
                                       ShowToolTip="True"
                                       SizeChanged="PowerTreeGrid_SizeChanged"
                                       TreeGridContextFlyoutOpening="PowerTreeGrid_TreeGridContextFlyoutOpening">
                        <sfgrid:SfTreeGrid.HeaderContextFlyout>
                            <MenuFlyout />
                        </sfgrid:SfTreeGrid.HeaderContextFlyout>
                        <sfgrid:SfTreeGrid.RecordContextFlyout>
                            <MenuFlyout />
                        </sfgrid:SfTreeGrid.RecordContextFlyout>
                        <sfgrid:SfTreeGrid.ExpanderContextFlyout>
                            <MenuFlyout />
                        </sfgrid:SfTreeGrid.ExpanderContextFlyout>
                        <sfgrid:SfTreeGrid.ColumnSizer>
                            <common:TreeGridStarColumnSizer />
                        </sfgrid:SfTreeGrid.ColumnSizer>
                        <sfgrid:SfTreeGrid.Columns>
                            <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                                       AllowEditing="False"
                                                       HeaderText="Setting"
                                                       MappingName="DisplayName"
                                                       ShowToolTip="True"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                            <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="1"
                                                           AllowEditing="True"
                                                           AllowSorting="True"
                                                           CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                           EditTemplateSelector="{StaticResource AcEditTemplateSelector}"
                                                           HeaderText="{x:Bind ViewModel.ActivePlanAcHeader, Mode=OneWay}"
                                                           MappingName="DisplayAc"
                                                           ShowToolTip="True">
                                <sfgrid:TreeGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="viewModels:PowerTreeNode">
                                        <TextBlock Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Bind DisplayAc, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </sfgrid:TreeGridTemplateColumn.CellTemplate>
                            </sfgrid:TreeGridTemplateColumn>
                            <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="1"
                                                           AllowEditing="True"
                                                           AllowSorting="True"
                                                           CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                           EditTemplateSelector="{StaticResource DcEditTemplateSelector}"
                                                           HeaderText="{x:Bind ViewModel.ActivePlanDcHeader, Mode=OneWay}"
                                                           MappingName="DisplayDc"
                                                           ShowToolTip="True">
                                <sfgrid:TreeGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="viewModels:PowerTreeNode">
                                        <TextBlock Margin="12,0"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Bind DisplayDc, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </sfgrid:TreeGridTemplateColumn.CellTemplate>
                            </sfgrid:TreeGridTemplateColumn>
                            <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="1"
                                                       AllowEditing="False"
                                                       CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                       HeaderText="{x:Bind ViewModel.ComparePlanAcHeader, Mode=OneWay}"
                                                       MappingName="DisplayCompareAc"
                                                       ShowToolTip="True"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                            <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="1"
                                                       AllowEditing="False"
                                                       CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                       HeaderText="{x:Bind ViewModel.ComparePlanDcHeader, Mode=OneWay}"
                                                       MappingName="DisplayCompareDc"
                                                       ShowToolTip="True"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                        </sfgrid:SfTreeGrid.Columns>
                    </sfgrid:SfTreeGrid>
                </dev:Case>
                <dev:Case Value="Identical">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <FontIcon HorizontalAlignment="Center"
                                  FontSize="32"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Glyph="&#xE73E;" />
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Power plans are identical" />
                    </StackPanel>
                </dev:Case>
            </dev:SwitchPresenter>

            <!--  View Changes  -->
            <sfgrid:SfTreeGrid x:Name="ChangesPowerTreeGrid"
                               common:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
                               AllowEditing="True"
                               AllowSorting="True"
                               AllowTriStateSorting="True"
                               AutoExpandMode="AllNodesExpanded"
                               AutoGenerateColumns="False"
                               CellToolTipOpening="PowerTreeGrid_CellToolTipOpening"
                               ChildPropertyName="Children"
                               ColumnWidthMode="Star"
                               CurrentCellBeginEdit="PowerTreeGrid_CurrentCellBeginEdit"
                               CurrentCellEndEdit="PowerTreeGrid_CurrentCellEndEdit"
                               DataValidationMode="InView"
                               EditTrigger="OnTap"
                               EditorSelectionBehavior="SelectAll"
                               FilterLevel="All"
                               GridLinesVisibility="Both"
                               HeaderLinesVisibility="Both"
                               ItemsSource="{x:Bind ViewModel.ChangeNodes}"
                               Loaded="PowerTreeGrid_Loaded"
                               NavigationMode="Cell"
                               PasteOption="None"
                               SelectionMode="Single"
                               ShowToolTip="True"
                               SizeChanged="PowerTreeGrid_SizeChanged"
                               TreeGridContextFlyoutOpening="PowerTreeGrid_TreeGridContextFlyoutOpening"
                               Visibility="{x:Bind ViewModel.ViewChangesVisibility, Mode=OneWay}">
                <sfgrid:SfTreeGrid.HeaderContextFlyout>
                    <MenuFlyout />
                </sfgrid:SfTreeGrid.HeaderContextFlyout>
                <sfgrid:SfTreeGrid.RecordContextFlyout>
                    <MenuFlyout />
                </sfgrid:SfTreeGrid.RecordContextFlyout>
                <sfgrid:SfTreeGrid.ExpanderContextFlyout>
                    <MenuFlyout />
                </sfgrid:SfTreeGrid.ExpanderContextFlyout>
                <sfgrid:SfTreeGrid.ColumnSizer>
                    <common:TreeGridStarColumnSizer />
                </sfgrid:SfTreeGrid.ColumnSizer>
                <sfgrid:SfTreeGrid.Columns>
                    <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="2"
                                               AllowEditing="False"
                                               HeaderText="Setting"
                                               MappingName="DisplayName"
                                               ShowToolTip="True"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                    <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="1"
                                               AllowEditing="False"
                                               CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                               HeaderText="Original (AC)"
                                               MappingName="DisplayOriginalAc"
                                               ShowToolTip="True"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                    <sfgrid:TreeGridTextColumn common:StarRatio.ColumnRatio="1"
                                               AllowEditing="False"
                                               CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                               HeaderText="Original (DC)"
                                               MappingName="DisplayOriginalDc"
                                               ShowToolTip="True"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                    <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="1"
                                                   AllowEditing="True"
                                                   AllowSorting="True"
                                                   CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                   EditTemplateSelector="{StaticResource AcEditTemplateSelector}"
                                                   HeaderText="New (AC)"
                                                   MappingName="DisplayAc"
                                                   ShowToolTip="True">
                        <sfgrid:TreeGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="viewModels:PowerTreeNode">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind DisplayAc, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </sfgrid:TreeGridTemplateColumn.CellTemplate>
                    </sfgrid:TreeGridTemplateColumn>
                    <sfgrid:TreeGridTemplateColumn common:StarRatio.ColumnRatio="1"
                                                   AllowEditing="True"
                                                   AllowSorting="True"
                                                   CellStyleSelector="{StaticResource PowerCellStyleSelector}"
                                                   EditTemplateSelector="{StaticResource DcEditTemplateSelector}"
                                                   HeaderText="New (DC)"
                                                   MappingName="DisplayDc"
                                                   ShowToolTip="True">
                        <sfgrid:TreeGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="viewModels:PowerTreeNode">
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind DisplayDc, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </sfgrid:TreeGridTemplateColumn.CellTemplate>
                    </sfgrid:TreeGridTemplateColumn>
                </sfgrid:SfTreeGrid.Columns>
            </sfgrid:SfTreeGrid>

            <!--  No Results  -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No result found"
                       Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
        </Grid>
    </Grid>
</Page>
