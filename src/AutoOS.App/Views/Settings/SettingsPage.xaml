<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="AutoOS.Views.Settings.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="using:AutoOS.Common"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dev="using:DevWinUI"
	xmlns:local="using:AutoOS"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="using:AutoOS.Views.Settings"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock
			Margin="36,24,0,0"
			Style="{StaticResource TitleTextBlockStyle}"
			Text="Settings" />
		<ScrollViewer
			Grid.Row="1"
			VerticalScrollBarVisibility="Auto"
			VerticalScrollMode="Auto">
			<StackPanel
				Margin="{ThemeResource ContentPageMargin}"
				Padding="{ThemeResource ContentPagePadding}"
				dev:PanelAttach.ChildrenTransitions="Default">
				<dev:SimpleSettingsGroup Margin="0,-48,0,0" Header="About">
					<dev:SettingsExpander
						Description="tinodin"
						Header="AutoOS"
						IsExpanded="False">
						<dev:SettingsExpander.HeaderIcon>
							<ImageIcon Source="/Assets/AppIcon.png" />
						</dev:SettingsExpander.HeaderIcon>
						<TextBlock
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							IsTextSelectionEnabled="True"
							Text="{x:Bind dev:ProcessInfoHelper.Version}" />
						<dev:SettingsExpander.Items>
							<dev:SettingsCard
								x:Name="CloneRepo"
								Click="CloneRepo_Click"
								Header="To clone this repository"
								IsClickEnabled="True">
								<TextBlock
									x:Name="GitCloneTextBlock"
									FontFamily="Consolas"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									IsTextSelectionEnabled="True"
									Text="git clone https://github.com/tinodin/AutoOS" />
								<dev:SettingsCard.ActionIcon>
									<FontIcon Glyph="&#xE8C8;" />
								</dev:SettingsCard.ActionIcon>
							</dev:SettingsCard>
							<dev:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
								<StackPanel Orientation="Vertical" Spacing="4">
									<TextBlock Text="Related Links" />
									<HyperlinkButton Content="Source Code" NavigateUri="https://github.com/tinodin/AutoOS" />
									<HyperlinkButton Content="Release Notes" NavigateUri="https://github.com/tinodin/AutoOS/releases" />
								</StackPanel>
							</dev:SettingsCard>
						</dev:SettingsExpander.Items>
					</dev:SettingsExpander>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Header="Window">
					<dev:SettingsCard
						Description="Enable to hide the AutoOS Startup window."
						Header="Hide AutoOS Startup"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
						                          Glyph=&#xE73F;}">
						<ToggleSwitch x:Name="HideStartup" Toggled="HideStartup_Toggled" />
					</dev:SettingsCard>
					<dev:SettingsCard
						Description="Restore the last known window state on launch."
						Header="Remember window state"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
						                          Glyph=&#xE737;}">
						<ToggleSwitch x:Name="RestoreWindowState" Toggled="RestoreWindowState_Toggled" />
					</dev:SettingsCard>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Header="Appearance &amp; behavior">
					<dev:SettingsCard Description="Select the theme that suits your mood and preference. You can choose from dark, light, or system themes." Header="App theme">
						<dev:SettingsCard.HeaderIcon>
							<ImageIcon Source="/Assets/Fluent/Theme.png" />
						</dev:SettingsCard.HeaderIcon>
						<ComboBox dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}">
							<ComboBoxItem Content="Light" Tag="Light" />
							<ComboBoxItem Content="Dark" Tag="Dark" />
							<ComboBoxItem Content="Default" Tag="Default" />
						</ComboBox>
					</dev:SettingsCard>
					<dev:SettingsCard Description="Change the appearance of the backdrop material behind your app. You can choose from mica, acrylic, or transparent options." Header="Material">
						<dev:SettingsCard.HeaderIcon>
							<ImageIcon Source="/Assets/Fluent/Backdrop.png" />
						</dev:SettingsCard.HeaderIcon>
						<ComboBox dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}">
							<ComboBoxItem Content="Mica" Tag="Mica" />
							<ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
							<ComboBoxItem Content="Acrylic" Tag="Acrylic" />
						</ComboBox>
					</dev:SettingsCard>
					<dev:SettingsCard
						Description="Sync your app’s color with your Windows accent color. You can open the Windows accent color setting by clicking this card."
						Header="Accent color"
						IsClickEnabled="True"
						LaunchUri="ms-settings:colors">
						<dev:SettingsCard.HeaderIcon>
							<ImageIcon Source="/Assets/Fluent/Color.png" />
						</dev:SettingsCard.HeaderIcon>
						<dev:SettingsCard.ActionIcon>
							<ImageIcon Source="/Assets/Fluent/External.png" />
						</dev:SettingsCard.ActionIcon>
					</dev:SettingsCard>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Margin="0,0,0,36" Header="Games">
					<dev:Card Title="Switch Emulator" Padding="24,24,24,12">
						<dev:Card.Content>
							<StackPanel Margin="0,0,0,12">
								<GridView
									x:Name="SwitchEmulator"
									SelectionChanged="SwitchEmulator_Changed"
									SelectionMode="Single">
									<GridView.ItemTemplate>
										<DataTemplate x:DataType="views:SettingsGridViewItem">
											<Grid Height="85" Margin="4">
												<Grid.RowDefinitions>
													<RowDefinition Height="*" />
												</Grid.RowDefinitions>
												<StackPanel VerticalAlignment="Center">
													<Image Height="36" Margin="0,0,0,4">
														<Image.Source>
															<BitmapImage
																DecodePixelHeight="36"
																DecodePixelType="Logical"
																UriSource="{x:Bind ImageSource, Mode=OneTime}" />
														</Image.Source>
													</Image>
													<TextBlock
														HorizontalAlignment="Center"
														FontSize="14"
														Text="{x:Bind Text}"
														TextAlignment="Center"
														TextTrimming="CharacterEllipsis"
														TextWrapping="Wrap" />
												</StackPanel>
											</Grid>
										</DataTemplate>
									</GridView.ItemTemplate>
									<GridView.ItemsPanel>
										<ItemsPanelTemplate>
											<controls:StaggeredPanel
												ColumnSpacing="4"
												DesiredColumnWidth="145"
												RowSpacing="12" />
										</ItemsPanelTemplate>
									</GridView.ItemsPanel>
								</GridView>
								<dev:SettingsCard Header="Executable Location" HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8A5;}">
									<common:TextBox
										x:Name="ExecutableLocationValue"
										MinWidth="300"
										PlaceholderText="Executable Location..."
										TextChanged="ExecutableLocation_TextChanged">
										<common:TextBox.Content>
											<Button Click="ExecutableLocation_Click" Content="&#xE838;" />
										</common:TextBox.Content>
									</common:TextBox>
								</dev:SettingsCard>
								<dev:SettingsCard Header="Data Location" HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8B7;}">
									<common:TextBox
										x:Name="DataLocationValue"
										MinWidth="300"
										PlaceholderText="Data Location..."
										TextChanged="DataLocation_TextChanged">
										<common:TextBox.Content>
											<Button Click="DataLocation_Click" Content="&#xE838;" />
										</common:TextBox.Content>
									</common:TextBox>
								</dev:SettingsCard>
							</StackPanel>
						</dev:Card.Content>
					</dev:Card>
				</dev:SimpleSettingsGroup>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
