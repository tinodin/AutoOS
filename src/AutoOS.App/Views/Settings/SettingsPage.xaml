<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="AutoOS.App.Views.Settings.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dev="using:DevWinUI"
	xmlns:local="using:AutoOS.App"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:uc="using:AutoOS.App.UserControls"
	xmlns:views="using:AutoOS.App.Views.Settings"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock
			Margin="36,24,0,0"
			Style="{StaticResource TitleTextBlockStyle}"
			Text="Settings" />
		<ScrollViewer
			Grid.Row="1"
			VerticalScrollBarVisibility="Auto"
			VerticalScrollMode="Auto">
			<StackPanel
				Margin="{ThemeResource ContentPageMargin}"
				Padding="{ThemeResource ContentPagePadding}"
				dev:PanelAttach.ChildrenTransitions="Default">
				<dev:SimpleSettingsGroup Margin="0,-48,0,0" Header="About">
					<dev:SettingsExpander
						Description="tinodin"
						Header="AutoOS"
						IsExpanded="False">
						<dev:SettingsExpander.HeaderIcon>
							<ImageIcon Source="/Assets/AppIcon.png" />
						</dev:SettingsExpander.HeaderIcon>
						<TextBlock
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							IsTextSelectionEnabled="True"
							Text="{x:Bind dev:ProcessInfoHelper.Version}" />
						<dev:SettingsExpander.Items>
							<dev:SettingsCard
								x:Name="CloneRepo"
								Click="CloneRepo_Click"
								Header="To clone this repository"
								IsClickEnabled="True">
								<TextBlock
									x:Name="GitCloneTextBlock"
									FontFamily="Consolas"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									IsTextSelectionEnabled="True"
									Text="git clone https://github.com/tinodin/AutoOS" />
								<dev:SettingsCard.ActionIcon>
									<FontIcon Glyph="&#xE8C8;" />
								</dev:SettingsCard.ActionIcon>
							</dev:SettingsCard>
							<dev:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
								<StackPanel Orientation="Vertical" Spacing="4">
									<TextBlock Text="Related Links" />
									<HyperlinkButton Content="Source Code" NavigateUri="https://github.com/tinodin/AutoOS" />
									<HyperlinkButton Content="Release Notes" NavigateUri="https://github.com/tinodin/AutoOS/releases" />
								</StackPanel>
							</dev:SettingsCard>
						</dev:SettingsExpander.Items>
					</dev:SettingsExpander>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Header="Window">
					<dev:SettingsCard
						Description="Enable to hide the AutoOS Startup window."
						Header="Hide AutoOS Startup"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
						                          Glyph=&#xE73F;}">
						<ToggleSwitch x:Name="HideStartup" Toggled="HideStartup_Toggled" />
					</dev:SettingsCard>
					<dev:SettingsCard
						Description="Restore the last known window state on launch."
						Header="Remember window state"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
						                          Glyph=&#xE737;}">
						<ToggleSwitch x:Name="RestoreWindowState" Toggled="RestoreWindowState_Toggled" />
					</dev:SettingsCard>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Header="Appearance &amp; behavior">
					<dev:SettingsCard Description="Select the theme that suits your mood and preference. You can choose from dark, light, or system themes." Header="App theme">
						<dev:SettingsCard.HeaderIcon>
							<ImageIcon Source="/Assets/FluentIcons/Pages/Settings/Theme.png" />
						</dev:SettingsCard.HeaderIcon>
						<uc:ComboBoxEx dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}">
							<ComboBoxItem Content="Use system setting" Tag="Default" />
							<ComboBoxItem Content="Light" Tag="Light" />
							<ComboBoxItem Content="Dark" Tag="Dark" />
						</uc:ComboBoxEx>
					</dev:SettingsCard>
					<dev:SettingsCard Description="Change the appearance of the backdrop material behind your app. You can choose from none, acrylic, or acrylic thin, mica and mica alt options." Header="Material">
						<dev:SettingsCard.HeaderIcon>
							<ImageIcon Source="/Assets/FluentIcons/Pages/Settings/Backdrop.png" />
						</dev:SettingsCard.HeaderIcon>
						<uc:ComboBoxEx dev:ThemeServiceAttach.ThemeService="{x:Bind local:App.Current.ThemeService}">
							<ComboBoxItem Content="None" Tag="None" />
							<ComboBoxItem Content="Acrylic" Tag="Acrylic" />
							<ComboBoxItem Content="AcrylicThin" Tag="AcrylicThin" />
							<ComboBoxItem Content="Mica" Tag="Mica" />
							<ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
						</uc:ComboBoxEx>
					</dev:SettingsCard>
					<dev:SettingsExpander
						Description="Add tint to your window to make your experience more personalized."
						Header="Tint Color"
						HeaderIcon="{dev:BitmapIcon Source=Assets/FluentIcons/Pages/Settings/Tint.png}"
						IsExpanded="True">
						<uc:DropdownColorPicker
							x:Name="MainDropdownColorPicker"
							ColorChanged="MainDropdownColorPicker_ColorChanged"
							ColorSpectrumShape="Ring"
							IsAlphaEnabled="True"
							IsAlphaSliderVisible="True"
							IsMoreButtonVisible="True" />
						<dev:SettingsExpander.ItemsHeader>
							<dev:SettingsCard>
								<dev:SettingsCard.Description>
									<dev:ColorPalette
										x:Name="ColorPalette"
										ColorChanged="ColorPalette_ColorChanged"
										ColorSet="Custom"
										ItemShape="Tab">
										<dev:ColorPalette.Colors>
											<dev:ColorPaletteItem ColorName="Default" Color="#00000000" />
											<dev:ColorPaletteItem ColorName="Yellow Gold" Color="#32FFB900" />
											<dev:ColorPaletteItem ColorName="Orange Bright" Color="#32F7630C" />
											<dev:ColorPaletteItem ColorName="Brick Red" Color="#32D13438" />
											<dev:ColorPaletteItem ColorName="Mod Red" Color="#32FF4343" />
											<dev:ColorPaletteItem ColorName="Red" Color="#32EA005E" />
											<dev:ColorPaletteItem ColorName="Rose Bright" Color="#32EA005E" />
											<dev:ColorPaletteItem ColorName="Blue" Color="#320078D7" />
											<dev:ColorPaletteItem ColorName="Iris Pastel" Color="#328764B8" />
											<dev:ColorPaletteItem ColorName="Violet Red Light" Color="#32B146C2" />
											<dev:ColorPaletteItem ColorName="Cool Blue Bright" Color="#320099BC" />
											<dev:ColorPaletteItem ColorName="Seafoam" Color="#3200B7C3" />
											<dev:ColorPaletteItem ColorName="Mint Light" Color="#3200B294" />
											<dev:ColorPaletteItem ColorName="Gray" Color="#327A7574" />
											<dev:ColorPaletteItem ColorName="Green" Color="#32107C10" />
											<dev:ColorPaletteItem ColorName="Overcast" Color="#32767676" />
											<dev:ColorPaletteItem ColorName="Storm" Color="#324C4A48" />
											<dev:ColorPaletteItem ColorName="Blue Gray" Color="#3269797E" />
											<dev:ColorPaletteItem ColorName="Gray Dark" Color="#324A5459" />
											<dev:ColorPaletteItem ColorName="Camouflage" Color="#327E735F" />
										</dev:ColorPalette.Colors>
									</dev:ColorPalette>
								</dev:SettingsCard.Description>
							</dev:SettingsCard>
						</dev:SettingsExpander.ItemsHeader>
					</dev:SettingsExpander>
					<dev:SettingsCard
						Description="Sync your app’s color with your Windows accent color. You can open the Windows accent color setting by clicking this card."
						Header="Accent color"
						IsClickEnabled="True"
						LaunchUri="ms-settings:colors">
						<dev:SettingsCard.HeaderIcon>
							<ImageIcon Source="/Assets/FluentIcons/Pages/Settings/Color.png" />
						</dev:SettingsCard.HeaderIcon>
						<dev:SettingsCard.ActionIcon>
							<ImageIcon Source="/Assets/FluentIcons/Pages/Settings/External.png" />
						</dev:SettingsCard.ActionIcon>
					</dev:SettingsCard>
					<dev:SettingsExpander
						x:Name="BackgroundImageExpander"
						Description="{x:Bind BackgroundImagePath, Mode=OneWay}"
						Header="Background Image"
						HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily},
						                          Glyph=&#xE91B;}"
						IsExpanded="False">
						<SplitButton
							x:Name="SelectImageButton"
							Click="SelectImage_Click"
							Content="Browse">
							<SplitButton.Flyout>
								<MenuFlyout Placement="Bottom">
									<MenuFlyoutItem
										x:Name="RemoveImageMenuItem"
										Click="RemoveImage_Click"
										Text="Remove" />
								</MenuFlyout>
							</SplitButton.Flyout>
						</SplitButton>
						<dev:SettingsExpander.Items>
							<dev:SettingsCard Header="Opacity">
								<Slider
									x:Name="ImageOpacitySlider"
									Width="140"
									HorizontalAlignment="Right"
									IsThumbToolTipEnabled="False"
									Maximum="1"
									Minimum="0.1"
									StepFrequency="0.1"
									Value="1"
									ValueChanged="ImageOpacity_ValueChanged" />
							</dev:SettingsCard>
							<dev:SettingsCard Header="Image Fit">
								<uc:ComboBoxEx
									x:Name="ImageFitComboBox"
									MinWidth="140"
									SelectionChanged="ImageFit_SelectionChanged">
									<ComboBoxItem Content="None" Tag="None" />
									<ComboBoxItem Content="Fill" Tag="Fill" />
									<ComboBoxItem Content="Uniform" Tag="Uniform" />
									<ComboBoxItem
										Content="Uniform To Fill"
										IsSelected="True"
										Tag="UniformToFill" />
								</uc:ComboBoxEx>
							</dev:SettingsCard>
							<dev:SettingsCard Header="Vertical Alignment">
								<uc:ComboBoxEx
									x:Name="ImageVerticalAlignmentComboBox"
									MinWidth="140"
									SelectionChanged="ImageVerticalAlignment_SelectionChanged">
									<ComboBoxItem Content="Top" Tag="Top" />
									<ComboBoxItem
										Content="Center"
										IsSelected="True"
										Tag="Center" />
									<ComboBoxItem Content="Bottom" Tag="Bottom" />
								</uc:ComboBoxEx>
							</dev:SettingsCard>
							<dev:SettingsCard Header="Horizontal Alignment">
								<uc:ComboBoxEx
									x:Name="ImageHorizontalAlignmentComboBox"
									MinWidth="140"
									SelectionChanged="ImageHorizontalAlignment_SelectionChanged">
									<ComboBoxItem Content="Left" Tag="Left" />
									<ComboBoxItem
										Content="Center"
										IsSelected="True"
										Tag="Center" />
									<ComboBoxItem Content="Right" Tag="Right" />
								</uc:ComboBoxEx>
							</dev:SettingsCard>
						</dev:SettingsExpander.Items>
					</dev:SettingsExpander>
				</dev:SimpleSettingsGroup>
				<dev:SimpleSettingsGroup Margin="0,0,0,36" Header="Games">
					<dev:Card Title="Switch Emulator" Padding="24,24,24,12">
						<dev:Card.Content>
							<StackPanel Margin="0,0,0,12">
								<GridView
									x:Name="SwitchEmulator"
									SelectionChanged="SwitchEmulator_Changed"
									SelectionMode="Single">
									<GridView.ItemTemplate>
										<DataTemplate x:DataType="views:SettingsGridViewItem">
											<Grid Height="85" Margin="4">
												<Grid.RowDefinitions>
													<RowDefinition Height="*" />
												</Grid.RowDefinitions>
												<StackPanel VerticalAlignment="Center">
													<Image Height="36" Margin="0,0,0,4">
														<Image.Source>
															<BitmapImage
																DecodePixelHeight="36"
																DecodePixelType="Logical"
																UriSource="{x:Bind ImageSource, Mode=OneTime}" />
														</Image.Source>
													</Image>
													<TextBlock
														HorizontalAlignment="Center"
														FontSize="14"
														Text="{x:Bind Text}"
														TextAlignment="Center"
														TextTrimming="CharacterEllipsis"
														TextWrapping="Wrap" />
												</StackPanel>
											</Grid>
										</DataTemplate>
									</GridView.ItemTemplate>
									<GridView.ItemsPanel>
										<ItemsPanelTemplate>
											<controls:StaggeredPanel
												ColumnSpacing="4"
												DesiredColumnWidth="145"
												RowSpacing="12" />
										</ItemsPanelTemplate>
									</GridView.ItemsPanel>
								</GridView>
								<dev:SettingsCard Header="Executable Location" HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8A5;}">
									<dev:TextBox
										x:Name="ExecutableLocationValue"
										MinWidth="300"
										PlaceholderText="Executable Location..."
										TextChanged="ExecutableLocation_TextChanged">
										<dev:TextBox.Content>
											<Button Click="ExecutableLocation_Click" Content="&#xE838;" />
										</dev:TextBox.Content>
									</dev:TextBox>
								</dev:SettingsCard>
								<dev:SettingsCard Header="Data Location" HeaderIcon="{dev:FontIcon FontFamily={StaticResource SymbolThemeFontFamily}, Glyph=&#xE8B7;}">
									<dev:TextBox
										x:Name="DataLocationValue"
										MinWidth="300"
										PlaceholderText="Data Location..."
										TextChanged="DataLocation_TextChanged">
										<dev:TextBox.Content>
											<Button Click="DataLocation_Click" Content="&#xE838;" />
										</dev:TextBox.Content>
									</dev:TextBox>
								</dev:SettingsCard>
							</StackPanel>
						</dev:Card.Content>
					</dev:Card>
				</dev:SimpleSettingsGroup>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
