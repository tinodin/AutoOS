<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="AutoOS.App.Views.Settings.SchedulingPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:data="using:Syncfusion.UI.Xaml.Data"
	xmlns:dev="using:DevWinUI"
	xmlns:ext="using:AutoOS.App.Extensions"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:sfgrid="using:Syncfusion.UI.Xaml.TreeGrid"
	xmlns:treegrid="using:AutoOS.App.Helpers.TreeGrid"
	mc:Ignorable="d">

	<Page.Resources>
		<treegrid:TreeGridSortComparer x:Key="NameComparer" PropertyName="Name" />
		<treegrid:TreeGridSortComparer x:Key="MsiModeComparer" PropertyName="MsiModeDisplay" />
		<treegrid:TreeGridSortComparer x:Key="MsiLimitComparer" PropertyName="MsiLimitDisplay" />
		<treegrid:TreeGridSortComparer x:Key="MaxMsiLimitComparer" PropertyName="MaxMsiLimitDisplay" />
		<treegrid:TreeGridSortComparer x:Key="DevicePolicyComparer" PropertyName="DevicePolicyDisplay" />
		<treegrid:TreeGridSortComparer x:Key="DevicePriorityComparer" PropertyName="DevicePriorityDisplay" />
		<treegrid:TreeGridSortComparer x:Key="SpecifiedProcessorsComparer" PropertyName="SpecifiedProcessorsDisplay" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="36,24,36,0">
			<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Per-CPU Scheduling" />
			<Border
				Margin="0,24,0,8"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{ThemeResource OverlayCornerRadius}">
				<CommandBar
					ext:CommandBarExtensions.ApplyOverflowIndent="True"
					ext:CommandBarExtensions.CommandAlignment="Left"
					ext:CommandBarExtensions.OverflowButtonAlignment="Right"
					DefaultLabelPosition="Right">

					<!--  Undo  -->
					<AppBarButton
						x:Name="UndoButton"
						Click="Undo_Click"
						Icon="{dev:FontIcon Glyph=&#xE7A7;}"
						Label="Undo"
						ToolTipService.ToolTip="Undo (Ctrl+Z)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="Z" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>

					<!--  Redo  -->
					<AppBarButton
						x:Name="RedoButton"
						Click="Redo_Click"
						Icon="{dev:FontIcon Glyph=&#xE7A6;}"
						Label="Redo"
						ToolTipService.ToolTip="Redo (Ctrl+Y)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="Y" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>

					<AppBarSeparator Margin="4,0" />

					<!--  Optimize  -->
					<AppBarButton
						x:Name="OptimizeButton"
						Click="Optimize_Click"
						Icon="{dev:FontIcon Glyph=&#xE945;}"
						Label="Optimize"
						ToolTipService.ToolTip="Optimize" />

					<AppBarSeparator Margin="4,0" />

					<!--  Restore  -->
					<AppBarButton
						x:Name="RestoreButton"
						Click="Restore_Click"
						Icon="{dev:FontIcon Glyph=&#xE777;}"
						Label="Restore"
						ToolTipService.ToolTip="Restore (Ctrl+R)">
						<AppBarButton.KeyboardAccelerators>
							<KeyboardAccelerator Key="R" Modifiers="Control" />
						</AppBarButton.KeyboardAccelerators>
					</AppBarButton>
				</CommandBar>
			</Border>
		</StackPanel>

		<Grid Grid.Row="1" Margin="36,0,36,36">
			<sfgrid:SfTreeGrid
				x:Name="TreeGrid"
				treegrid:TreeGridSelectionControllerHelper.UseCustomSelectionController="True"
				AllowSorting="True"
				AllowTriStateSorting="True"
				AutoExpandMode="AllNodesExpanded"
				AutoGenerateColumns="False"
				CellToolTipOpening="TreeGrid_CellToolTipOpening"
				ChildPropertyName="SubItems"
				ColumnWidthMode="Star"
				ContextRequested="TreeGrid_ContextRequested"
				DoubleTapped="TreeGrid_DoubleTapped"
				ExpandStateMappingName="IsExpanded"
				FilterLevel="All"
				GridLinesVisibility="Both"
				HeaderLinesVisibility="Both"
				ItemsSource="{x:Bind Nodes}"
				NavigationMode="Row"
				SelectionMode="Single"
				ShowToolTip="True"
				SizeChanged="TreeGrid_SizeChanged"
				Tapped="TreeGrid_Tapped"
				TreeGridContextFlyoutOpening="TreeGrid_TreeGridContextFlyoutOpening">
				<sfgrid:SfTreeGrid.HeaderContextFlyout>
					<MenuFlyout />
				</sfgrid:SfTreeGrid.HeaderContextFlyout>
				<sfgrid:SfTreeGrid.ColumnSizer>
					<treegrid:TreeGridStarColumnSizer />
				</sfgrid:SfTreeGrid.ColumnSizer>
				<sfgrid:SfTreeGrid.SortComparers>
					<data:SortComparer Comparer="{StaticResource NameComparer}" PropertyName="Name" />
					<data:SortComparer Comparer="{StaticResource MsiModeComparer}" PropertyName="MsiModeDisplay" />
					<data:SortComparer Comparer="{StaticResource MsiLimitComparer}" PropertyName="MsiLimitDisplay" />
					<data:SortComparer Comparer="{StaticResource MaxMsiLimitComparer}" PropertyName="MaxMsiLimitDisplay" />
					<data:SortComparer Comparer="{StaticResource DevicePolicyComparer}" PropertyName="DevicePolicyDisplay" />
					<data:SortComparer Comparer="{StaticResource DevicePriorityComparer}" PropertyName="DevicePriorityDisplay" />
					<data:SortComparer Comparer="{StaticResource SpecifiedProcessorsComparer}" PropertyName="SpecifiedProcessorsDisplay" />
				</sfgrid:SfTreeGrid.SortComparers>
				<sfgrid:SfTreeGrid.Columns>
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="2"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="Name"
						MappingName="Name"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="1"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="MSI Mode"
						MappingName="MsiModeDisplay"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="1"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="MSI Limit"
						MappingName="MsiLimitDisplay"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="1"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="Max MSI Limit"
						MappingName="MaxMsiLimitDisplay"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="1"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="Device Policy"
						MappingName="DevicePolicyDisplay"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="1"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="Device Priority"
						MappingName="DevicePriorityDisplay"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<sfgrid:TreeGridTextColumn
						treegrid:StarRatio.ColumnRatio="1"
						AllowEditing="False"
						AllowFocus="False"
						HeaderText="Specified Proc"
						MappingName="SpecifiedProcessorsDisplay"
						ShowToolTip="True"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
				</sfgrid:SfTreeGrid.Columns>
			</sfgrid:SfTreeGrid>
		</Grid>
	</Grid>
</Page>
