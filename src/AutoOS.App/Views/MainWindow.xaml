<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="AutoOS.App.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dev="using:DevWinUI"
	xmlns:local="using:AutoOS.App"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Grid
		x:Name="RootGrid"
		Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
		Loaded="RootGrid_Loaded">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TitleBar
			x:Name="AppTitleBar"
			Background="{x:Bind RootGrid.Background, Mode=OneWay}"
			IsBackButtonVisible="False"
			IsPaneToggleButtonVisible="True"
			Subtitle="{x:Bind dev:ProcessInfoHelper.VersionWithPrefix}">
			<TitleBar.LeftHeader>
				<ImageIcon
					Width="16"
					Height="16"
					Margin="4,0,8,0"
					PointerPressed="AppIcon_PointerPressed"
					Source="/Assets/AppIcon.png" />
			</TitleBar.LeftHeader>
		</TitleBar>
		<dev:ModernWindowCaptionButtonToolTip Window="{x:Bind}" />
		<NavigationView
			x:Name="NavView"
			Grid.Row="1"
			Background="{x:Bind RootGrid.Background, Mode=OneWay}"
			IsBackButtonVisible="Collapsed"
			IsPaneToggleButtonVisible="False"
			IsSettingsVisible="False"
			OpenPaneLength="256">
			<NavigationView.Resources>
				<SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
				<CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
				<Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
				<Thickness x:Key="NavigationViewContentMargin">0</Thickness>
				<CornerRadius x:Key="NavigationViewMinimalContentGridCornerRadius">0</CornerRadius>
				<Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
				<Thickness x:Key="NavigationViewMinimalContentMargin">0</Thickness>
				<Thickness x:Key="NavigationViewItemMargin">2,0,2,0</Thickness>
			</NavigationView.Resources>
			<Grid
				Margin="0,4,8,8"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch">
				<Border
					Background="{ThemeResource LayerFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="8">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<dev:BreadcrumbNavigator x:Name="BreadCrumbNav" Margin="16,8,16,0" />
						<Frame x:Name="NavFrame" Grid.Row="1" />
					</Grid>
				</Border>
			</Grid>
		</NavigationView>
	</Grid>
</Window>
