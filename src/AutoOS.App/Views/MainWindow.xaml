<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="AutoOS.App.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dev="using:DevWinUI"
	xmlns:local="using:AutoOS.App"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TitleBar
			x:Name="AppTitleBar"
			Title="AutoOS"
			IsBackButtonVisible="True"
			IsPaneToggleButtonVisible="True"
			Subtitle="{x:Bind dev:ProcessInfoHelper.VersionWithPrefix}">
			<TitleBar.Resources>
				<HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
			</TitleBar.Resources>
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
			</TitleBar.IconSource>
			<TitleBar.RightHeader>
				<dev:StatusCenterButton x:Name="AppStatusCenterButton" ToolTipService.ToolTip="Status center (Ctrl+Alt+S)">
					<dev:StatusCenterButton.KeyboardAccelerators>
						<KeyboardAccelerator
							Key="S"
							Invoked="ToggleStatusCenter"
							Modifiers="Control,Menu" />
					</dev:StatusCenterButton.KeyboardAccelerators>
				</dev:StatusCenterButton>
			</TitleBar.RightHeader>
			<AutoSuggestBox
				x:Name="NavSearchBox"
				MaxWidth="480"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Center"
				PlaceholderText="Search"
				QueryIcon="Find"
				QuerySubmitted="NavSearchBox_QuerySubmitted"
				TextChanged="NavSearchBox_TextChanged">
				<AutoSuggestBox.ItemTemplate>
					<DataTemplate x:DataType="dev:DataItem">
						<Grid ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Viewbox
								Width="16"
								Height="16"
								VerticalAlignment="Center">
								<Image Source="{x:Bind ImagePath}" />
							</Viewbox>
							<TextBlock Grid.Column="1" Text="{x:Bind Title}" />
						</Grid>
					</DataTemplate>
				</AutoSuggestBox.ItemTemplate>
				<AutoSuggestBox.KeyboardAccelerators>
					<KeyboardAccelerator
						Key="F"
						Invoked="NavSearchBox_AcceleratorInvoked"
						Modifiers="Control,Menu" />
				</AutoSuggestBox.KeyboardAccelerators>
			</AutoSuggestBox>
		</TitleBar>
		<dev:ModernWindowCaptionButtonToolTip Window="{x:Bind}" />
		<NavigationView
			x:Name="NavView"
			Grid.Row="1"
			IsBackButtonVisible="Collapsed"
			IsPaneToggleButtonVisible="False"
			IsSettingsVisible="False"
			OpenPaneLength="256">
			<NavigationView.Header>
				<dev:BreadcrumbNavigator x:Name="BreadCrumbNav" />
			</NavigationView.Header>
			<Frame x:Name="NavFrame" />
		</NavigationView>
	</Grid>
</Window>
